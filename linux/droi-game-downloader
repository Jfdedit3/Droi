#!/usr/bin/python3
"""Droi Game Downloader: SteamRE DepotDownloader frontend for ARM64."""
import os, sys, re, shutil, subprocess, tempfile, zipfile, stat, fcntl
from pathlib import Path, PurePosixPath
from urllib.parse import urlparse

TAG="DepotDownloader_3.4.0"
ASSET="DepotDownloader-linux-arm64.zip"
URL="https://github.com/SteamRE/DepotDownloader/releases/download/"+TAG+"/"+ASSET
BASE=Path.home()/".local/share/droi"
ENGINE=BASE/"depotdownloader"/TAG
GAMES=BASE/"games"

def app_id(value):
    value=value.strip()
    if not value.isascii() or not value.isdecimal():
        u=urlparse(value)
        m=re.match(r"^/app/([0-9]+)(?:/|$)",u.path)
        if u.scheme!="https" or u.hostname!="store.steampowered.com" or not m:
            raise ValueError("AppID ou lien Steam invalide")
        value=m.group(1)
    if len(value)>10 or not 0<int(value)<=4294967295:
        raise ValueError("AppID invalide")
    return str(int(value))

def command(binary, app, platform, threads, auth, username, verify):
    if platform not in ("windows","linux") or not 1<=threads<=32:
        raise ValueError("Paramètres invalides")
    app=app_id(app)
    args=[str(binary),"-app",app,"-os",platform,"-osarch","64","-dir",str(GAMES/app),"-max-downloads",str(threads)]
    if auth=="qr": args+=["-qr"]
    elif auth=="account":
        if not username.strip() or username.startswith("-"): raise ValueError("Identifiant Steam requis")
        args+=["-username",username]
    elif auth!="anonymous": raise ValueError("Authentification invalide")
    if verify: args+=["-validate"]
    return args

def install_engine():
    BASE.mkdir(parents=True,exist_ok=True)
    binary=ENGINE/"DepotDownloader"
    with open(BASE/"depotdownloader.lock","a") as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        if binary.is_file() and os.access(binary,os.X_OK): return binary
        ENGINE.parent.mkdir(parents=True,exist_ok=True)
        with tempfile.TemporaryDirectory(dir=ENGINE.parent) as temp:
            temp=Path(temp); archive=temp/"engine.zip"; target=temp/"extract"; target.mkdir()
            subprocess.run(["curl","--proto","=https","--proto-redir","=https","-fL","--retry","3","-o",str(archive),URL],check=True)
            if archive.stat().st_size!=32026406:
                raise RuntimeError("Taille du paquet moteur inattendue")
            with zipfile.ZipFile(archive) as z:
                if sum(x.file_size for x in z.infolist())>512*1024*1024:
                    raise RuntimeError("Archive trop volumineuse")
                for x in z.infolist():
                    p=PurePosixPath(x.filename)
                    if p.is_absolute() or ".." in p.parts or stat.S_ISLNK(x.external_attr>>16):
                        raise RuntimeError("Archive invalide")
                z.extractall(target)
            for path in target.rglob("*"):
                if path.is_file(): path.chmod(0o755)
            if not (target/"DepotDownloader").is_file(): raise RuntimeError("Moteur absent")
            if ENGINE.exists(): raise RuntimeError("Installation moteur incomplète : "+str(ENGINE))
            target.rename(ENGINE)
        return binary

def download(argv):
    app,platform,threads,auth,user,verify=argv
    app=app_id(app)
    GAMES.mkdir(parents=True,exist_ok=True)
    with open(GAMES/("."+app+".lock"),"a") as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        print("Installation / vérification du moteur ARM64...",flush=True)
        binary=install_engine()
        args=command(binary,app,platform,int(threads),auth,user,verify=="1")
        print("Dossier :",GAMES/app,flush=True)
        print("Connexion Steam : suis les instructions Steam Guard dans ce terminal.",flush=True)
        env=dict(os.environ,DOTNET_SYSTEM_GLOBALIZATION_INVARIANT="1")
        rc=subprocess.call(args,cwd=ENGINE,env=env)
        print("Téléchargement terminé." if rc==0 else "Échec du téléchargement : "+str(rc),flush=True)
        return rc

def main():
    import gi
    gi.require_version("Gtk","3.0")
    from gi.repository import Gtk
    win=Gtk.Window(title="Droi Game Downloader");win.set_default_size(570,420)
    box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=10);box.set_border_width(18);win.add(box)
    title=Gtk.Label();title.set_markup("<span size='x-large' weight='bold'>Droi Game Downloader</span>");title.set_xalign(0);box.pack_start(title,False,False,0)
    def label(text):
        l=Gtk.Label(label=text);l.set_xalign(0);l.set_line_wrap(True);box.pack_start(l,False,False,0)
    label("Télécharge les jeux accessibles à ton compte Steam, sans client Steam complet.")
    app=Gtk.Entry();app.set_placeholder_text("AppID ou lien du magasin Steam");box.pack_start(app,False,False,0)
    def combo(items):
        c=Gtk.ComboBoxText()
        for k,v in items: c.append(k,v)
        c.set_active(0);box.pack_start(c,False,False,0);return c
    platform=combo([("windows","Windows x64 / Proton"),("linux","Linux x64")])
    auth=combo([("qr","Connexion Steam par QR code"),("account","Identifiant Steam et Steam Guard"),("anonymous","Anonyme (contenus publics uniquement)")])
    user=Gtk.Entry();user.set_placeholder_text("Identifiant Steam");user.set_sensitive(False);box.pack_start(user,False,False,0)
    auth.connect("changed",lambda *_:user.set_sensitive(auth.get_active_id()=="account"))
    label("Téléchargements parallèles (8–32 ; 16 recommandé)")
    threads=Gtk.SpinButton.new_with_range(8,32,1);threads.set_value(16);box.pack_start(threads,False,False,0)
    verify=Gtk.CheckButton(label="Vérifier les fichiers existants");box.pack_start(verify,False,False,0)
    status=Gtk.Label(label="Les fichiers sont conservés pour reprendre un téléchargement.");status.set_line_wrap(True);box.pack_start(status,False,False,0)
    btn=Gtk.Button(label="Télécharger");btn.get_style_context().add_class("suggested-action");box.pack_start(btn,False,False,0)
    def start(*_):
        try:
            ident=app_id(app.get_text())
            command("DepotDownloader",ident,platform.get_active_id(),threads.get_value_as_int(),auth.get_active_id(),user.get_text(),verify.get_active())
            args=["/usr/bin/droi-game-downloader","--download",ident,platform.get_active_id(),str(threads.get_value_as_int()),auth.get_active_id(),user.get_text(),"1" if verify.get_active() else "0"]
            for terminal,flags in (("konsole",["--hold","-e"]),("xfce4-terminal",["--hold","-x"]),("qterminal",["-e"]),("xterm",["-hold","-e"])):
                if shutil.which(terminal):
                    subprocess.Popen([terminal]+flags+args)
                    status.set_text("Téléchargement lancé : progression et connexion dans le terminal.")
                    return
            raise RuntimeError("Aucun terminal graphique disponible")
        except Exception as error: status.set_text(str(error))
    btn.connect("clicked",start)
    folder=Gtk.Button(label="Ouvrir le dossier des jeux")
    def open_folder(*_):
        GAMES.mkdir(parents=True,exist_ok=True)
        subprocess.Popen(["xdg-open",str(GAMES)])
    folder.connect("clicked",open_folder);box.pack_start(folder,False,False,0)
    win.connect("destroy",Gtk.main_quit);win.show_all();Gtk.main()

if __name__=="__main__":
    if len(sys.argv)>1 and sys.argv[1]=="--download":
        try: sys.exit(download(sys.argv[2:]))
        except Exception as error:
            print("Erreur :",error,file=sys.stderr);sys.exit(1)
    main()
