#!/usr/bin/python3
"""Launch trusted Windows files using Droi's installed compatibility tools."""
import os
import hashlib
import fcntl
import signal
import time
import uuid
import json
import tempfile
from pathlib import Path
import runpy
import shutil
import subprocess
import sys

PROTON = "/usr/local/bin/droiddeck-proton-run"
OPEN = "/usr/local/bin/droiddeck-open"
DESKTOP = "droi-windows.desktop"
GRAPHICS = ("auto", "performance", "compatibility")
MIMES = ("application/x-ms-dos-executable", "application/x-msdownload",
         "application/vnd.microsoft.portable-executable", "application/x-dosexec",
         "application/x-msi")
ENTRY = """[Desktop Entry]
Type=Application
Name=Droi - Wine / Proton
Comment=Ouvrir un programme Windows avec le moteur installe
Exec=/usr/bin/droi-windows %f
Icon=application-x-ms-dos-executable
Terminal=false
Categories=Utility;
MimeType=""" + ";".join(MIMES) + ";\n"


def install():
    directory = Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))) / "applications"
    directory.mkdir(parents=True, exist_ok=True)
    (directory / DESKTOP).write_text(ENTRY, encoding="utf-8")
    (directory / "droi-wine-manager.desktop").write_text(
        "[Desktop Entry]\nType=Application\nName=Droi - Processus Wine\n"
        "Comment=Afficher et fermer les processus Wine et Proton\n"
        "Exec=/usr/bin/droi-windows --wine-manager\nIcon=utilities-system-monitor\n"
        "Terminal=false\nCategories=System;Utility;\n", encoding="utf-8")
    # Additional Open With entries allow a per-program choice from Dolphin.
    debug_entry = ENTRY.replace("Name=Droi - Wine / Proton", "Name=Droi - Diagnostic")
    debug_entry = debug_entry.replace("Exec=/usr/bin/droi-windows %f", "Exec=/usr/bin/droi-windows --debug %f")
    (directory / "droi-windows-debug.desktop").write_text(debug_entry, encoding="utf-8")
    prepare_entry = ENTRY.replace("Name=Droi - Wine / Proton", "Name=Droi - Preparer le prefixe")
    prepare_entry = prepare_entry.replace("Exec=/usr/bin/droi-windows %f", "Exec=/usr/bin/droi-windows --prepare %f")
    (directory / "droi-windows-prepare.desktop").write_text(prepare_entry, encoding="utf-8")
    for option, label in (("--cancel", "Annuler le lancement"),
                          ("--stop-prefix", "Fermer les processus Wine de ce programme"),
                          ("--sync esync", "Tester ESYNC")):
        body = ENTRY.replace("Name=Droi - Wine / Proton", "Name=Droi - " + label)
        body = body.replace("Exec=/usr/bin/droi-windows %f",
                            "Exec=/usr/bin/droi-windows " + option + " %f")
        (directory / ("droi-windows-" + option.split()[-1].lstrip("-") + ".desktop")).write_text(body, encoding="utf-8")
    for mode, label in (("performance", "Performance (Vulkan / Zink)"),
                        ("compatibility", "Compatibilite (OpenGL logiciel)"),
                        ("auto", "Automatique")):
        body = ENTRY.replace("Name=Droi - Wine / Proton", "Name=Droi - " + label)
        body = body.replace("Exec=/usr/bin/droi-windows %f",
                            "Exec=/usr/bin/droi-windows --graphics " + mode + " %f")
        (directory / ("droi-windows-" + mode + ".desktop")).write_text(body, encoding="utf-8")
    if shutil.which("update-desktop-database"):
        subprocess.run(["update-desktop-database", str(directory)], check=False)
    if not shutil.which("xdg-mime"):
        raise RuntimeError("xdg-mime absent")
    for mime in MIMES:
        subprocess.run(["xdg-mime", "default", DESKTOP, mime], check=True, env={**os.environ, "DE":"generic","XDG_CURRENT_DESKTOP":"Droi","DESKTOP_SESSION":"droi","KDE_FULL_SESSION":"","KDE_SESSION_VERSION":""})
    for binary in ("kbuildsycoca6", "kbuildsycoca5"):
        if shutil.which(binary):
            subprocess.run([binary, "--noincremental"], check=False)
            break
    return 0


def validate(path):
    if not path.is_file():
        raise ValueError("Fichier introuvable : " + str(path))
    with path.open("rb") as source:
        signature = source.read(8)
    if path.suffix.lower() == ".exe" and signature.startswith(b"MZ"):
        return
    if path.suffix.lower() == ".msi" and signature == bytes.fromhex("D0CF11E0A1B11AE1"):
        return
    raise ValueError("Fichier Windows .exe ou .msi invalide : " + str(path))


def profile_file(path):
    root = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    key = hashlib.sha256(os.fsencode(path.resolve())).hexdigest()
    return root / "droi/windows-profiles" / (key + ".json")


def graphics_profile(path, selected=None):
    record = profile_file(path)
    if selected is not None:
        if selected not in GRAPHICS:
            raise ValueError("Mode graphique invalide : " + selected)
        record.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=record.parent,
                                         delete=False) as output:
            tmp = Path(output.name)
            json.dump({"graphics": selected}, output)
        try:
            os.replace(tmp, record)
        finally:
            tmp.unlink(missing_ok=True)
    else:
        try:
            selected = json.loads(record.read_text(encoding="utf-8")).get("graphics")
        except (OSError, ValueError, AttributeError):
            selected = None
    if selected not in GRAPHICS:
        selected = "auto"
    if selected == "auto":
        return "compatibility" if path.name.casefold() in ("geometrydash.exe", "nfsc.exe") else "auto"
    return selected


def compatibility_env(env):
    env.update(DROI_GRAPHICS_MODE="compatibility", DD_DESKTOP_GPU="off",
               LIBGL_ALWAYS_SOFTWARE="1", GALLIUM_DRIVER="llvmpipe",
               MESA_LOADER_DRIVER_OVERRIDE="swrast")
    env.pop("LIBGL_KOPPER_DRI2", None)


def installed():
    module = runpy.run_path(PROTON)
    root = os.environ.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or module["STEAM_ROOT"]
    return module["desktop_tools"](root)


def error(message):
    print("Droi : " + message, file=sys.stderr)
    if (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) and shutil.which("kdialog"):
        subprocess.run(["kdialog", "--error", message], check=False)
    return 1


def launch_lock(path):
    directory = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "droi/windows-launches"
    directory.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha256(os.fsencode(path.resolve())).hexdigest()
    return directory / (key + ".lock")


def request_cancel(path):
    lock = launch_lock(path)
    with lock.open("a+", encoding="utf-8") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            handle.seek(0)
            token = handle.read().strip()
            if len(token) != 32 or any(c not in "0123456789abcdef" for c in token):
                return error("Le lancement se prepare. Reessaie dans un instant.")
            (lock.parent / (token + ".cancel")).touch()
            print("Annulation demandee : " + path.name, flush=True)
            return 0
        return error("Aucun lancement Droi actif pour " + path.name)


def notify(message):
    print(message, flush=True)
    if (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) and shutil.which("notify-send"):
        try:
            subprocess.run(["notify-send", "-a", "Droi", "Droi Windows", message],
                           timeout=3, check=False)
        except (OSError, subprocess.SubprocessError):
            pass


class LaunchProgress:
    """Optional KDE indeterminate progress. The context-menu cancel stays available."""
    def __init__(self, name):
        self.address = None
        self.bus = None
        if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
            return
        self.bus = next((p for p in (shutil.which("qdbus6"), shutil.which("qdbus")) if p), None)
        if not self.bus or not shutil.which("kdialog"):
            return
        try:
            result = subprocess.run(["kdialog", "--title", "Droi", "--progressbar",
                                     "Demarrage de " + name + " ...", "0"],
                                    capture_output=True, text=True, timeout=5, check=True)
            address = result.stdout.strip().split()
            if len(address) == 2 and address[0].startswith("org.kde.kdialog") and address[1].startswith("/"):
                self.address = address
                self.call("showCancelButton", "true")
        except (OSError, subprocess.SubprocessError):
            pass

    def call(self, method, *args):
        if not self.address:
            return ""
        try:
            return subprocess.run([self.bus, *self.address, method, *args], capture_output=True,
                                  text=True, timeout=1, check=False).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return ""

    def cancelled(self):
        return self.call("wasCancelled").lower() == "true"

    def close(self):
        self.call("close")
        self.address = None


def stop_group(process):
    # Limit signals to this launch's process group, never to all Wine processes.
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def run_game(path, command, cwd, env):
    lock = launch_lock(path)
    with lock.open("a+", encoding="utf-8") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return error(path.name + " est deja en cours de lancement ou d'execution. Utilise Ouvrir avec > Droi - Annuler le lancement si necessaire.")
        token = uuid.uuid4().hex
        cancel = lock.parent / (token + ".cancel")
        handle.seek(0)
        handle.truncate()
        handle.write(token)
        handle.flush()
        progress = None
        process = None
        started = time.monotonic()
        try:
            env = dict(env, DROI_LAUNCH_TOKEN=token)
            process = subprocess.Popen(command, cwd=cwd, env=env, start_new_session=True)
            notify("Demarrage de " + path.name + " (premier lancement parfois long).")
            while process.poll() is None:
                elapsed = time.monotonic() - started
                if cancel.exists() or (progress is not None and progress.cancelled()):
                    if progress:
                        progress.close()
                    stop_group(process)
                    notify("Lancement annule : " + path.name)
                    return 130
                # Do not pretend to know Wine's actual progress. Show an indeterminate dialog
                # for the startup period only; no automatic kill of a slow or running game.
                if progress is None and elapsed >= 2 and elapsed < 90:
                    progress = LaunchProgress(path.name)
                if progress and elapsed >= 90:
                    progress.close()
                time.sleep(0.5)
            return process.returncode
        except BaseException:
            if process is not None and process.poll() is None:
                stop_group(process)
            raise
        finally:
            if progress:
                progress.close()
            cancel.unlink(missing_ok=True)
            handle.seek(0)
            handle.truncate()
            handle.flush()


WINE_NAMES = {"wine", "wine64", "wine-preloader", "wine64-preloader",
              "wineserver", "wineserver64", "wine.bin", "wine64.bin"}
PROC = Path("/proc")


def process_info(pid, proc=PROC):
    """Only same-UID, recognizable Wine processes; never arbitrary Android processes."""
    folder = proc / str(pid)
    try:
        owner = next(line.split()[1] for line in (folder / "status").read_text().splitlines()
                     if line.startswith("Uid:"))
        own = next(line.split()[1] for line in (proc / "self/status").read_text().splitlines()
                   if line.startswith("Uid:"))
        if owner != own or pid == os.getpid():
            return None
        stat = (folder / "stat").read_text().rsplit(")", 1)[1].split()
        if stat[0] == "Z":
            return None
        start = stat[19]
        comm = (folder / "comm").read_text().strip()
        argv = (folder / "cmdline").read_bytes().split(b"\0")
        first = os.fsdecode(argv[0]) if argv else ""
        names = {comm.casefold(), Path(first).name.casefold()}
        try:
            names.add(Path(os.readlink(folder / "exe")).name.casefold())
        except OSError:
            pass
        # A Windows-looking filename alone is not sufficient to identify Wine.
        environment = {}
        try:
            for item in (folder / "environ").read_bytes().split(b"\0"):
                key, sep, value = item.partition(b"=")
                if sep and key in (b"WINEPREFIX", b"STEAM_COMPAT_DATA_PATH", b"DROI_LAUNCH_TOKEN"):
                    environment[os.fsdecode(key)] = os.fsdecode(value)
        except OSError:
            pass
        prefix = environment.get("WINEPREFIX") or (
            os.path.join(environment["STEAM_COMPAT_DATA_PATH"], "pfx")
            if environment.get("STEAM_COMPAT_DATA_PATH") else "")
        if not (names & WINE_NAMES or (prefix and any(name.endswith(".exe") for name in names))):
            return None
        if prefix and not os.path.isabs(prefix):
            prefix = ""
        if prefix:
            prefix = os.path.realpath(prefix)
        return {"pid": pid, "start": start, "name": comm, "prefix": prefix,
                "server": bool(names & {"wineserver", "wineserver64"}),
                "token": environment.get("DROI_LAUNCH_TOKEN", "")}
    except (OSError, IndexError, StopIteration, ValueError):
        return None


def wine_processes():
    rows = []
    for folder in PROC.iterdir():
        if folder.name.isdecimal():
            found = process_info(int(folder.name))
            if found:
                rows.append(found)
    return sorted(rows, key=lambda row: (row["prefix"], row["server"], row["pid"]))


def wine_prefix(path):
    module = runpy.run_path(PROTON)
    root = os.environ.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or module["STEAM_ROOT"]
    return os.path.realpath(os.path.join(module["locate"](str(path.absolute()), root).compatdata, "pfx"))


def describe_processes(rows):
    return "\n".join("%s  %s  %s" % (r["pid"], r["name"], r["prefix"] or "(prefixe inconnu)")
                     for r in rows)


def same_process(row):
    current = process_info(row["pid"])
    return current is not None and current["start"] == row["start"]


def confirm_stop(message, yes=False):
    if yes:
        return True
    if (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) and shutil.which("kdialog"):
        return subprocess.run(["kdialog", "--warningyesno", message], check=False).returncode == 0
    if sys.stdin.isatty():
        return input(message + " [o/N] ").strip().lower() in ("o", "oui", "y", "yes")
    print(message + "\nUtilise --yes pour confirmer en terminal.", file=sys.stderr)
    return False


def stop_wine(rows, yes=False):
    if not rows:
        notify("Aucun processus Wine correspondant.")
        return 0
    if not confirm_stop("Fermer %d processus Wine ? Les donnees non enregistrees seront perdues." % len(rows), yes):
        return 1
    # Cancel only matching Droi launchers, so they cannot respawn these clients.
    for row in rows:
        token = row["token"]
        if len(token) == 32 and all(c in "0123456789abcdef" for c in token):
            (launch_lock(Path("/")).parent / (token + ".cancel")).touch()
    def send(row, sig):
        if same_process(row):
            try:
                os.kill(row["pid"], sig)
            except (ProcessLookupError, PermissionError):
                pass
    # First allow clients to exit, then stop detached wineservers.
    for row in rows:
        if not row["server"]:
            send(row, signal.SIGTERM)
    time.sleep(0.5)
    for row in rows:
        if row["server"]:
            send(row, signal.SIGTERM)
    until = time.monotonic() + 3
    while time.monotonic() < until and any(same_process(row) for row in rows):
        time.sleep(0.2)
    for row in rows:
        send(row, signal.SIGKILL)
    time.sleep(0.2)
    remaining = [row for row in rows if same_process(row)]
    if remaining:
        return error("Certains processus Wine restent actifs :\n" + describe_processes(remaining))
    notify("Processus Wine selectionnes fermes.")
    return 0


def wine_manager():
    if not shutil.which("kdialog") or not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        print(describe_processes(wine_processes()) or "Aucun processus Wine visible.")
        print("Utilise droi-windows --stop-wine PID ou --stop-wine all")
        return 0
    while True:
        rows = wine_processes()
        if not rows:
            subprocess.run(["kdialog", "--msgbox", "Aucun processus Wine visible."], check=False)
            return 0
        menu = ["all", "Fermer tous les processus Wine", "refresh", "Actualiser"]
        for index, prefix in enumerate(sorted({r["prefix"] for r in rows if r["prefix"]})):
            menu += ["prefix:" + str(index), "Fermer prefixe : " + prefix]
        prefixes = sorted({r["prefix"] for r in rows if r["prefix"]})
        for row in rows:
            menu += [str(row["pid"]), "%s - %s" % (row["pid"], row["name"])]
        result = subprocess.run(["kdialog", "--title", "Droi - Processus Wine", "--menu",
                                 "%d processus Wine visibles. Choisis les processus a fermer." % len(rows), *menu],
                                capture_output=True, text=True, check=False)
        if result.returncode != 0:
            return 0
        selection = result.stdout.strip()
        if selection == "refresh":
            continue
        if selection == "all":
            chosen = rows
        elif selection.startswith("prefix:") and selection[7:].isdigit() and int(selection[7:]) < len(prefixes):
            chosen = [r for r in rows if r["prefix"] == prefixes[int(selection[7:])]]
        else:
            chosen = [r for r in rows if str(r["pid"]) == selection]
        stop_wine(chosen)


def main(args):
    try:
        if args == ["--install"]:
            return install()
        if args == ["--list"]:
            for name in installed():
                print(name)
            wine = shutil.which("wine")
            if wine:
                print("Wine : " + wine)
            return 0
        if args == ["--wine-manager"]:
            return wine_manager()
        if args == ["--processes"]:
            print(describe_processes(wine_processes()) or "Aucun processus Wine visible.")
            return 0
        if len(args) in (2, 3) and args[0] == "--stop-wine":
            if len(args) == 3 and args[2] != "--yes":
                raise ValueError("Option attendue : --yes")
            target = args[1]
            if target != "all" and not target.isdecimal():
                raise ValueError("Utilise --stop-wine PID ou --stop-wine all")
            return stop_wine([r for r in wine_processes() if target == "all" or str(r["pid"]) == target],
                             len(args) == 3)
        if len(args) in (2, 3) and args[0] == "--stop-prefix":
            if len(args) == 3 and args[2] != "--yes":
                raise ValueError("Option attendue : --yes")
            prefix = wine_prefix(Path(args[1]))
            return stop_wine([r for r in wine_processes() if r["prefix"] == prefix], len(args) == 3)
        if len(args) == 2 and args[0] == "--cancel":
            return request_cancel(Path(args[1]).absolute())
        window = False
        graphics = None
        debug = False
        prepare = False
        sync = "auto"
        while args and args[0] in ("--window", "--graphics", "--debug", "--prepare", "--sync"):
            option, args = args[0], args[1:]
            if option == "--window":
                window = True
            elif option == "--debug":
                debug = True
            elif option == "--prepare":
                prepare = True
            elif option == "--sync":
                if not args or args[0] not in ("auto", "esync"):
                    raise ValueError("Modes de synchronisation : auto, esync")
                sync, args = args[0], args[1:]
            else:
                if not args or args[0] not in GRAPHICS:
                    raise ValueError("Modes graphiques : auto, performance, compatibility")
                graphics, args = args[0], args[1:]
        if args and args[0] == "--":
            args = args[1:]
        if not args:
            raise ValueError("Usage : droi-windows [--debug] [--prepare] [--sync auto|esync] [--graphics auto|performance|compatibility] [--window] FICHIER.exe [ARGUMENTS...]")
        path = Path(args[0]).absolute()
        validate(path)
        env = os.environ.copy()
        env["DROI_WINDOWS_LAUNCH"] = "1"
        env["DROI_FAST_LAUNCH"] = "0" if debug else "1"
        env["DROI_SYNC_MODE"] = sync
        if debug:
            env["DD_GAME_LOGS"] = "1"
        else:
            env["DD_GAME_LOGS"] = "0"
            env.pop("PROTON_LOG", None)
            env["WINEDEBUG"] = "-all,err+all"
            env["DXVK_LOG_LEVEL"] = "error"
            env["VKD3D_DEBUG"] = "err"
        if prepare and args[1:]:
            raise ValueError("--prepare ne prend pas d'arguments de jeu")
        mode = graphics_profile(path, graphics)
        env["DROI_GRAPHICS_MODE"] = mode
        if mode == "compatibility":
            compatibility_env(env)
        elif mode == "performance":
            env["DD_DESKTOP_GPU"] = "on"
            window = False
        if installed():
            if prepare:
                # Initialize the same Proton prefix without executing the game or opening Gamescope.
                env["DD_DESKTOP_GPU"] = "off"
                env["DROI_PREPARE_PREFIX"] = "1"
                command = [PROTON, "--window", "--", str(path)]
            elif mode == "compatibility":
                # Direct launch bypasses Gamescope, but keeps Proton's normal per-program prefix.
                command = [PROTON, "--window", "--", str(path), *args[1:]]
            else:
                command = [OPEN] + (["--window"] if window else []) + ["--", str(path), *args[1:]]
        else:
            if prepare:
                return error("La preparation de prefixe necessite Proton.")
            wine = shutil.which("wine")
            if not wine:
                return error("Aucun Proton ou Wine installe. Ferme Ubuntu puis installe Proton dans Droi > Composants.")
            if path.suffix.lower() == ".msi":
                command = [wine, "msiexec", "/i", "Z:" + str(path).replace("/", "\\"), *args[1:]]
            else:
                command = [wine, str(path), *args[1:]]
        result = run_game(path, command, cwd=str(path.parent), env=env)
        if prepare:
            message = "Prefixe initialise. Tu peux maintenant lancer le jeu." if result == 0 else "Preparation du prefixe echouee (code %s)." % result
            print(message, flush=True)
            if (env.get("DISPLAY") or env.get("WAYLAND_DISPLAY")) and shutil.which("kdialog"):
                subprocess.run(["kdialog", "--msgbox" if result == 0 else "--error", message], check=False)
        return result
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        return error(str(exc))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
