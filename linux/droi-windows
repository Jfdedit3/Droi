#!/usr/bin/python3
"""Launch trusted Windows files using Droi's installed compatibility tools."""
import os
import hashlib
import json
import tempfile
from pathlib import Path
import runpy
import shutil
import subprocess
import sys

PROTON = "/usr/local/bin/droiddeck-proton-run"
OPEN = "/usr/local/bin/droiddeck-open"
DESKTOP = "droi-windows.desktop"
GRAPHICS = ("auto", "performance", "compatibility")
MIMES = ("application/x-ms-dos-executable", "application/x-msdownload",
         "application/vnd.microsoft.portable-executable", "application/x-dosexec",
         "application/x-msi")
ENTRY = """[Desktop Entry]
Type=Application
Name=Droi - Wine / Proton
Comment=Ouvrir un programme Windows avec le moteur installe
Exec=/usr/bin/droi-windows %f
Icon=application-x-ms-dos-executable
Terminal=false
Categories=Utility;
MimeType=""" + ";".join(MIMES) + ";\n"


def install():
    directory = Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))) / "applications"
    directory.mkdir(parents=True, exist_ok=True)
    (directory / DESKTOP).write_text(ENTRY, encoding="utf-8")
    # Additional Open With entries allow a per-program choice from Dolphin.
    debug_entry = ENTRY.replace("Name=Droi - Wine / Proton", "Name=Droi - Diagnostic")
    debug_entry = debug_entry.replace("Exec=/usr/bin/droi-windows %f", "Exec=/usr/bin/droi-windows --debug %f")
    (directory / "droi-windows-debug.desktop").write_text(debug_entry, encoding="utf-8")
    prepare_entry = ENTRY.replace("Name=Droi - Wine / Proton", "Name=Droi - Preparer le prefixe")
    prepare_entry = prepare_entry.replace("Exec=/usr/bin/droi-windows %f", "Exec=/usr/bin/droi-windows --prepare %f")
    (directory / "droi-windows-prepare.desktop").write_text(prepare_entry, encoding="utf-8")
    for mode, label in (("performance", "Performance (Vulkan / Zink)"),
                        ("compatibility", "Compatibilite (OpenGL logiciel)"),
                        ("auto", "Automatique")):
        body = ENTRY.replace("Name=Droi - Wine / Proton", "Name=Droi - " + label)
        body = body.replace("Exec=/usr/bin/droi-windows %f",
                            "Exec=/usr/bin/droi-windows --graphics " + mode + " %f")
        (directory / ("droi-windows-" + mode + ".desktop")).write_text(body, encoding="utf-8")
    if shutil.which("update-desktop-database"):
        subprocess.run(["update-desktop-database", str(directory)], check=False)
    if not shutil.which("xdg-mime"):
        raise RuntimeError("xdg-mime absent")
    for mime in MIMES:
        subprocess.run(["xdg-mime", "default", DESKTOP, mime], check=True)
    for binary in ("kbuildsycoca6", "kbuildsycoca5"):
        if shutil.which(binary):
            subprocess.run([binary, "--noincremental"], check=False)
            break
    return 0


def validate(path):
    if not path.is_file():
        raise ValueError("Fichier introuvable : " + str(path))
    with path.open("rb") as source:
        signature = source.read(8)
    if path.suffix.lower() == ".exe" and signature.startswith(b"MZ"):
        return
    if path.suffix.lower() == ".msi" and signature == bytes.fromhex("D0CF11E0A1B11AE1"):
        return
    raise ValueError("Fichier Windows .exe ou .msi invalide : " + str(path))


def profile_file(path):
    root = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    key = hashlib.sha256(os.fsencode(path.resolve())).hexdigest()
    return root / "droi/windows-profiles" / (key + ".json")


def graphics_profile(path, selected=None):
    record = profile_file(path)
    if selected is not None:
        if selected not in GRAPHICS:
            raise ValueError("Mode graphique invalide : " + selected)
        record.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=record.parent,
                                         delete=False) as output:
            tmp = Path(output.name)
            json.dump({"graphics": selected}, output)
        try:
            os.replace(tmp, record)
        finally:
            tmp.unlink(missing_ok=True)
    else:
        try:
            selected = json.loads(record.read_text(encoding="utf-8")).get("graphics")
        except (OSError, ValueError, AttributeError):
            selected = None
    if selected not in GRAPHICS:
        selected = "auto"
    if selected == "auto":
        return "compatibility" if path.name.casefold() == "geometrydash.exe" else "auto"
    return selected


def compatibility_env(env):
    env.update(DROI_GRAPHICS_MODE="compatibility", DD_DESKTOP_GPU="off",
               LIBGL_ALWAYS_SOFTWARE="1", GALLIUM_DRIVER="llvmpipe",
               MESA_LOADER_DRIVER_OVERRIDE="swrast")
    env.pop("LIBGL_KOPPER_DRI2", None)


def installed():
    module = runpy.run_path(PROTON)
    root = os.environ.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or module["STEAM_ROOT"]
    return module["desktop_tools"](root)


def error(message):
    print("Droi : " + message, file=sys.stderr)
    if (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) and shutil.which("kdialog"):
        subprocess.run(["kdialog", "--error", message], check=False)
    return 1


def main(args):
    try:
        if args == ["--install"]:
            return install()
        if args == ["--list"]:
            for name in installed():
                print(name)
            wine = shutil.which("wine")
            if wine:
                print("Wine : " + wine)
            return 0
        window = False
        graphics = None
        debug = False
        prepare = False
        while args and args[0] in ("--window", "--graphics", "--debug", "--prepare"):
            option, args = args[0], args[1:]
            if option == "--window":
                window = True
            elif option == "--debug":
                debug = True
            elif option == "--prepare":
                prepare = True
            else:
                if not args or args[0] not in GRAPHICS:
                    raise ValueError("Modes graphiques : auto, performance, compatibility")
                graphics, args = args[0], args[1:]
        if args and args[0] == "--":
            args = args[1:]
        if not args:
            raise ValueError("Usage : droi-windows [--debug] [--prepare] [--graphics auto|performance|compatibility] [--window] FICHIER.exe [ARGUMENTS...]")
        path = Path(args[0]).absolute()
        validate(path)
        env = os.environ.copy()
        env["DROI_WINDOWS_LAUNCH"] = "1"
        env["DROI_FAST_LAUNCH"] = "0" if debug else "1"
        if debug:
            env["DD_GAME_LOGS"] = "1"
        else:
            env["DD_GAME_LOGS"] = "0"
            env.pop("PROTON_LOG", None)
            env["WINEDEBUG"] = "-all,err+all"
            env["DXVK_LOG_LEVEL"] = "error"
            env["VKD3D_DEBUG"] = "err"
        if prepare and args[1:]:
            raise ValueError("--prepare ne prend pas d'arguments de jeu")
        mode = graphics_profile(path, graphics)
        env["DROI_GRAPHICS_MODE"] = mode
        if mode == "compatibility":
            compatibility_env(env)
        elif mode == "performance":
            env["DD_DESKTOP_GPU"] = "on"
            window = False
        if installed():
            if prepare:
                # Initialize the same Proton prefix without executing the game or opening Gamescope.
                env["DD_DESKTOP_GPU"] = "off"
                env["DROI_PREPARE_PREFIX"] = "1"
                command = [PROTON, "--window", "--", str(path)]
            elif mode == "compatibility":
                # Direct launch bypasses Gamescope, but keeps Proton's normal per-program prefix.
                command = [PROTON, "--window", "--", str(path), *args[1:]]
            else:
                command = [OPEN] + (["--window"] if window else []) + ["--", str(path), *args[1:]]
        else:
            if prepare:
                return error("La preparation de prefixe necessite Proton.")
            wine = shutil.which("wine")
            if not wine:
                return error("Aucun Proton ou Wine installe. Ferme Ubuntu puis installe Proton dans Droi > Composants.")
            if path.suffix.lower() == ".msi":
                command = [wine, "msiexec", "/i", "Z:" + str(path).replace("/", "\\"), *args[1:]]
            else:
                command = [wine, str(path), *args[1:]]
        result = subprocess.call(command, cwd=str(path.parent), env=env)
        if prepare:
            message = "Prefixe initialise. Tu peux maintenant lancer le jeu." if result == 0 else "Preparation du prefixe echouee (code %s)." % result
            print(message, flush=True)
            if (env.get("DISPLAY") or env.get("WAYLAND_DISPLAY")) and shutil.which("kdialog"):
                subprocess.run(["kdialog", "--msgbox" if result == 0 else "--error", message], check=False)
        return result
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        return error(str(exc))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
