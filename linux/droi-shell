#!/usr/bin/python3
"""Droi's independent X11 desktop shell, with an EWMH window manager."""
import os
import sys
import shutil
import subprocess
import datetime
from pathlib import Path
import math

def scale_value(value):
    return int(value) if str(value) in {"100","125","150","200"} else 150

def metrics(width, height, percent):
    s = percent / 100
    unit = min(s, max(.8, height / 620))
    bar = min(54, max(34, round(34*unit)))
    return {"bar": bar, "icon": min(28, max(18, round(20*unit))),
            "menu_w": min(width-24, max(310, min(round(490*unit), round(width*.48)))),
            "menu_h": min(height-bar-20, max(280, round(height*.72))),
            "font": max(11, min(15, round(12*unit)))}

def matches(name, description, query):
    return all(word in (name+" "+description).casefold() for word in query.casefold().split())

def main():
    import gi
    gi.require_version("Gtk","3.0")
    gi.require_version("Gdk","3.0")
    gi.require_version("Wnck","3.0")
    gi.require_version("GdkX11","3.0")
    from gi.repository import Gtk, Gdk, GdkX11, Gio, GLib, Wnck, Pango
    import cairo
    screen=Gdk.Screen.get_default()
    if screen is None:
        return 1
    width,height=screen.get_width(),screen.get_height()
    percent=scale_value(os.environ.get("DROI_DESKTOP_SCALE",150))
    m=metrics(width,height,percent)
    bar_h,icon=m["bar"],m["icon"]
    theme=Gtk.Settings.get_default()
    if theme:
        theme.set_property("gtk-application-prefer-dark-theme",False)
        theme.set_property("gtk-theme-name","Adwaita")
    css=Gtk.CssProvider()
    css.load_from_data(("""
      #taskbar {background: #edf3fa; border-top: 1px solid #d3dfed;}
      #start-menu {background: #edf3fb; border: 1px solid #c1cfe0; border-radius: 9px;}
      #start-menu, #taskbar {font-family: "Segoe UI", "Noto Sans", sans-serif; font-size: %dpx; color:#20242b;}
      #start-menu button, #taskbar button {background-image:none; border:0; box-shadow:none; background-color:transparent; border-radius:5px; padding:4px; color:#20242b;}
      #start-menu button:hover, #taskbar button:hover {background-color:#dce6f3;}
      #taskbar button.active {background-color:#dce6f3; border-bottom:3px solid #1674d1;}
      #start-menu entry {font-size:%dpx; background:#fff; border:1px solid #d2dce8; border-bottom:2px solid #176bc0; border-radius:5px; padding:5px 9px; color:#20242b;}
      #start-menu label, #taskbar label {color:#20242b;}
      #start-menu .heading {font-weight:600;}
      #start-menu .secondary {background-color:#f9fbfe; border:1px solid #d6e0ec; padding:3px 8px;}
      #start-menu .muted {color:#596777;}
      #start-menu .footer {background-color:#e4ebf5; padding:5px 12px; border-top:1px solid #d6e0eb;}
    """ % (m["font"], m["font"])).encode())
    Gtk.StyleContext.add_provider_for_screen(screen,css,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    def window(hint, name, w,h,x,y):
        win=Gtk.Window()
        win.set_name(name)
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_type_hint(hint)
        win.set_default_size(w,h)
        win.move(x,y)
        return win
    bg=window(Gdk.WindowTypeHint.DESKTOP,"desktop",width,height,0,0)
    bg.set_keep_below(True)
    bg.set_accept_focus(False)
    canvas=Gtk.DrawingArea()
    def draw(widget,cr):
        w,h=widget.get_allocated_width(),widget.get_allocated_height()
        cr.scale(w,h)
        grad=cairo.LinearGradient(0,0,1,1)
        grad.add_color_stop_rgb(0,.67,.81,.94)
        grad.add_color_stop_rgb(1,.49,.68,.84)
        cr.set_source(grad);cr.paint()
        # Separate folded ribbons, painted back-to-front with shaded edges.
        def ribbon(cx,cy,angle,rx,ry,count,phase):
            cr.save();cr.translate(cx,cy);cr.rotate(angle);cr.scale(rx,ry)
            for i in range(count):
                t=i/max(1,count-1)
                cr.new_path()
                cr.move_to(-.93+t*.32,.72-t*.20)
                cr.curve_to(-1.28+t*.38,.08,-.63+t*.30,-1.22+t*.48,.13+t*.16,-.96+t*.38)
                cr.curve_to(.95-t*.14,-1.00+t*.40,1.22-t*.28,-.26+t*.19,.83-t*.19,.36+t*.09)
                cr.curve_to(.57-t*.10,.84,.04+t*.17,.92,-.93+t*.32,.72-t*.20)
                g=cairo.LinearGradient(-.80,-.9,.75,.85)
                g.add_color_stop_rgb(0,.04,.37+.12*t,.87)
                g.add_color_stop_rgb(.22,.08,.68+.12*t,1)
                g.add_color_stop_rgb(.48,.025,.36+.12*t,.92)
                g.add_color_stop_rgb(.77,.015,.16+.08*t,.65)
                g.add_color_stop_rgb(1,.012,.055,.30)
                cr.set_source(g);cr.fill_preserve()
                cr.set_line_width(.009)
                cr.set_source_rgba(.45,.83,1,.45);cr.stroke()
            cr.restore()
        ribbon(.38,.58,-.34,.31,.36,9,0)
        ribbon(.60,.36,-.63,.29,.43,10,0)
        ribbon(.72,.69,.56,.29,.30,8,0)
        ribbon(.40,.84,-.44,.32,.28,7,0)
        return False
    canvas.connect("draw",draw)
    bg.add(canvas);bg.show_all()
    bar=window(Gdk.WindowTypeHint.DOCK,"taskbar",width,bar_h,0,height-bar_h)
    bar.set_keep_above(True);bar.set_accept_focus(False)
    outer=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=6)
    outer.set_margin_start(10);outer.set_margin_end(10)
    center=Gtk.Box(spacing=5);tasks=Gtk.Box(spacing=3)
    right=Gtk.Box(spacing=8)
    outer.set_center_widget(center);outer.pack_end(right,False,False,0)
    bar.add(outer)
    menu=window(Gdk.WindowTypeHint.DIALOG,"start-menu",m["menu_w"],m["menu_h"],
                (width-m["menu_w"])//2,height-bar_h-m["menu_h"]-8)
    menu.set_keep_above(True)
    # Shape the X11 window without requiring a compositor (no black corners).
    def shape_menu(widget,*_):
        win=widget.get_window()
        if win is None: return
        w,h=widget.get_allocated_width(),widget.get_allocated_height()
        radius=9
        region=cairo.Region()
        for y in range(h):
            edge=min(y,h-1-y)
            inset=round(radius-math.sqrt(max(0,radius*radius-(radius-edge)**2))) if edge<radius else 0
            region.union(cairo.RectangleInt(inset,y,max(1,w-2*inset),1))
        win.shape_combine_region(region,0,0)
    menu.connect("size-allocate",shape_menu)
    menu.connect("delete-event",lambda *a: (menu.hide(),True)[1])
    root=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=0);menu.add(root)
    content=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8)
    content.set_border_width(18);root.pack_start(content,True,True,0)
    search=Gtk.SearchEntry();search.set_placeholder_text("Rechercher des applications")
    content.pack_start(search,False,False,0)
    header=Gtk.Box(spacing=6)
    headline=Gtk.Label(label="Épinglé");headline.set_xalign(0)
    headline.get_style_context().add_class("heading")
    header.pack_start(headline,True,True,0)
    all_button=Gtk.Button(label="Toutes les applications  ›")
    all_button.get_style_context().add_class("secondary")
    header.pack_end(all_button,False,False,0)
    content.pack_start(header,False,False,0)
    pinned=Gtk.FlowBox();pinned.set_selection_mode(Gtk.SelectionMode.NONE)
    columns=6 if m["menu_w"]>=480 else 4
    pinned.set_max_children_per_line(columns);pinned.set_min_children_per_line(columns)
    pinned.set_homogeneous(True);pinned.set_row_spacing(4);pinned.set_column_spacing(3)
    content.pack_start(pinned,False,False,0)
    recommendation=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8)
    rec_label=Gtk.Label(label="Recommandations");rec_label.set_xalign(0)
    rec_label.get_style_context().add_class("heading")
    recommendation.pack_start(rec_label,False,False,0)
    recent_box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=4)
    recommendation.pack_start(recent_box,False,False,0)
    content.pack_start(recommendation,True,True,0)
    scroll=Gtk.ScrolledWindow();scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC)
    scroll.set_min_content_height(80)
    grid=Gtk.FlowBox();grid.set_selection_mode(Gtk.SelectionMode.NONE)
    grid.set_min_children_per_line(columns);grid.set_max_children_per_line(columns)
    grid.set_homogeneous(True);grid.set_row_spacing(4);grid.set_column_spacing(4)
    scroll.add(grid);content.pack_start(scroll,True,True,0)
    footer=Gtk.Box(spacing=8);footer.get_style_context().add_class("footer")
    root.pack_end(footer,False,False,0)
    profile=Gtk.Box(spacing=8)
    profile_icon=Gtk.Image.new_from_icon_name("avatar-default",Gtk.IconSize.BUTTON)
    profile_icon.set_pixel_size(24);profile.pack_start(profile_icon,False,False,0)
    profile.pack_start(Gtk.Label(label=os.environ.get("USER","Ubuntu")),False,False,0)
    footer.pack_start(profile,False,False,0)
    recent=[]
    all_mode=False
    def launch(argv):
        menu.hide()
        try:
            subprocess.Popen(argv,start_new_session=True)
        except OSError as e:
            dialog=Gtk.MessageDialog(transient_for=bar,modal=True,message_type=Gtk.MessageType.ERROR,buttons=Gtk.ButtonsType.CLOSE,text=str(e))
            dialog.run();dialog.destroy()
    def choose(*commands):
        for command in commands:
            if shutil.which(command): return command
        return None
    def image(name,size=icon):
        # Draw dark system glyphs so light-theme symbolic icons cannot vanish.
        if name in ("system-search","system-shutdown","user-desktop"):
            im=Gtk.DrawingArea();im.set_size_request(size,size)
            def glyph(widget,cr):
                cr.scale(widget.get_allocated_width()/24,widget.get_allocated_height()/24)
                cr.set_source_rgb(.13,.19,.27);cr.set_line_width(1.8)
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                if name=="system-search":
                    cr.arc(10,10,5.8,0,2*math.pi);cr.stroke()
                    cr.move_to(14.4,14.4);cr.line_to(20,20);cr.stroke()
                elif name=="system-shutdown":
                    cr.arc(12,12,8,-math.pi*.25,math.pi*1.25);cr.stroke()
                    cr.move_to(12,2);cr.line_to(12,11);cr.stroke()
                else:
                    cr.rectangle(5,5,14,13);cr.stroke()
                return False
            im.connect("draw",glyph);return im
        im=Gtk.Image.new_from_icon_name(name,Gtk.IconSize.DIALOG)
        im.set_pixel_size(size);return im
    def button(name,ico,action,caption=False):
        b=Gtk.Button();box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL if caption else Gtk.Orientation.HORIZONTAL,spacing=4)
        box.pack_start(image(ico),False,False,0)
        if caption:
            lb=Gtk.Label(label=name);lb.set_max_width_chars(12);lb.set_ellipsize(Pango.EllipsizeMode.END);box.pack_start(lb,False,False,0)
        if caption: b.set_size_request(0,icon+27)
        b.add(box);b.set_tooltip_text(name)
        def invoke(*_):
            if caption:
                remember(name,ico,action)
            action()
        b.connect("clicked",invoke)
        return b
    def open_cmd(*argv): launch(list(argv))
    files=choose("dolphin","thunar","pcmanfm-qt","pcmanfm")
    terminal=choose("konsole","xfce4-terminal","qterminal","xterm")
    browser="/usr/local/bin/droi-brave" if os.geteuid()==0 else str(Path.home()/".local/bin/droi-brave")
    favourites=[]
    if files: favourites.append(("Fichiers","system-file-manager",lambda: open_cmd(files,str(Path.home()))))
    if terminal: favourites.append(("Terminal","utilities-terminal",lambda: open_cmd(terminal)))
    if os.access(browser,os.X_OK): favourites.append(("Brave","brave-browser" if Gtk.IconTheme.get_default().has_icon("brave-browser") else "web-browser",lambda: open_cmd(browser)))
    if shutil.which("droiddeck-steam-launch"): favourites.append(("Steam","steam",lambda: open_cmd("droiddeck-steam-launch","desktop")))
    chatgpt_launcher = "/usr/local/bin/chatgpt" if os.geteuid()==0 else str(Path.home()/".local/bin/chatgpt")
    if os.access(chatgpt_launcher,os.X_OK):
        favourites.append(("ChatGPT","chatgpt" if Gtk.IconTheme.get_default().has_icon("chatgpt") else "applications-internet",lambda: open_cmd(chatgpt_launcher)))
    if shutil.which("droi-windows"): favourites.append(("Processus Wine","application-x-executable",lambda: open_cmd("droi-windows","--wine-manager")))
    if shutil.which("droi-update"): favourites.insert(4,("Droi Update","system-software-update",lambda: open_cmd("droi-update")))
    def remember(name,ico,action):
        recent[:] = [(n,i,a) for n,i,a in recent if n!=name]
        recent.insert(0,(name,ico,action))
        del recent[4:]
    def show_recent():
        for child in recent_box.get_children(): recent_box.remove(child)
        if not recent:
            empty=Gtk.Label(label="Les applications récemment ouvertes apparaîtront ici.")
            empty.set_xalign(0);empty.set_line_wrap(True)
            empty.get_style_context().add_class("muted")
            recent_box.pack_start(empty,False,False,0)
        else:
            for name,ico,action in recent:
                item=Gtk.Button();row=Gtk.Box(spacing=10)
                row.pack_start(image(ico,22),False,False,0)
                title=Gtk.Label(label=name);title.set_xalign(0)
                row.pack_start(title,True,True,0);item.add(row)
                item.connect("clicked",lambda _,a=action:a())
                recent_box.pack_start(item,False,False,0)
        recent_box.show_all()
    def rebuild_apps(*_):
        for child in grid.get_children(): grid.remove(child)
        query=search.get_text()
        apps=sorted(Gio.AppInfo.get_all(),key=lambda a:a.get_display_name().casefold())
        seen=set()
        for app in apps:
            name=app.get_display_name()
            if not app.should_show() or not matches(name,app.get_description() or "",query): continue
            ident=app.get_id() or name
            if "firefox" in ident.casefold() or ("brave" in ident.casefold() and ident != "droi-brave.desktop") or ("chatgpt" in ident.casefold() and ident != "droi-chatgpt.desktop"): continue
            if ident in seen: continue
            seen.add(ident)
            btn=Gtk.Button(); vb=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=4)
            gicon=app.get_icon()
            im=Gtk.Image.new_from_gicon(gicon,Gtk.IconSize.DIALOG) if gicon else image("application-x-executable")
            im.set_pixel_size(icon);vb.pack_start(im,False,False,0)
            lb=Gtk.Label(label=name);lb.set_max_width_chars(12);lb.set_ellipsize(Pango.EllipsizeMode.END);vb.pack_start(lb,False,False,0)
            btn.add(vb);btn.set_tooltip_text(name)
            def start(_btn,app=app):
                menu.hide()
                try: app.launch([],None)
                except GLib.Error as e: print("Droi: application launch failed",e,flush=True)
            btn.connect("clicked",start);grid.add(btn)
        grid.show_all()
    def update_menu(*_):
        active=all_mode or bool(search.get_text().strip())
        headline.set_text("Toutes les applications" if active else "Épinglé")
        all_button.set_label("‹ Retour" if active else "Toutes les applications  ›")
        pinned.set_visible(not active);recommendation.set_visible(not active)
        scroll.set_visible(active)
        if active: rebuild_apps()
    def toggle_all(*_):
        nonlocal all_mode
        all_mode=not (all_mode or bool(search.get_text().strip()))
        search.set_text("");update_menu()
    all_button.connect("clicked",toggle_all)
    search.connect("search-changed",update_menu)
    def toggle_menu():
        nonlocal all_mode
        if menu.get_visible(): menu.hide();return
        all_mode=False;search.set_text("")
        for c in pinned.get_children(): pinned.remove(c)
        for name,ico,action in favourites: pinned.add(button(name,ico,action,True))
        show_recent();menu.show_all();update_menu()
        menu.resize(m["menu_w"],m["menu_h"])
        menu.move((width-m["menu_w"])//2,height-bar_h-m["menu_h"]-8)
        menu.present();search.grab_focus()
    def key(_win,event):
        if event.keyval==Gdk.KEY_Escape: menu.hide();return True
        return False
    menu.connect("key-press-event",key)
    def quit_session():
        dialog=Gtk.MessageDialog(transient_for=menu,modal=True,message_type=Gtk.MessageType.QUESTION,buttons=Gtk.ButtonsType.YES_NO,text="Fermer la session Ubuntu ?")
        dialog.format_secondary_text("Enregistre ton travail avant de quitter.")
        response=dialog.run();dialog.destroy()
        if response==Gtk.ResponseType.YES: Gtk.main_quit()
    footer.pack_end(button("Quitter Ubuntu","system-shutdown",quit_session),False,False,0)
    # Start icon is drawn independently from the installed theme.
    start=Gtk.Button();start.set_tooltip_text("Démarrer")
    squares=Gtk.DrawingArea();squares.set_size_request(icon,icon)
    def logo(w,cr):
        n=w.get_allocated_width();sz=(n-3)/2
        cr.set_source_rgb(.06,.42,.84)
        for x in (0,sz+3):
            for y in (0,sz+3): cr.rectangle(x,y,sz,sz)
        cr.fill();return False
    squares.connect("draw",logo);start.add(squares);start.connect("clicked",lambda *_:toggle_menu())
    center.pack_start(start,False,False,0)
    center.pack_start(button("Rechercher","system-search",toggle_menu),False,False,0)
    for name,ico,action in favourites[:4]: center.pack_start(button(name,ico,action),False,False,0)
    center.pack_start(tasks,False,False,0)
    clock=Gtk.Label();clock.set_justify(Gtk.Justification.RIGHT);right.pack_start(clock,False,False,0)
    def update_clock():
        clock.set_text(datetime.datetime.now().strftime("%H:%M\n%d/%m/%Y"));return True
    update_clock();GLib.timeout_add_seconds(30,update_clock)
    right.pack_start(button("Afficher le bureau","user-desktop",lambda: ws.toggle_showing_desktop(not ws.get_showing_desktop())),False,False,0)
    Wnck.set_client_type(Wnck.ClientType.PAGER)
    ws=Wnck.Screen.get_default()
    def rebuild_tasks(*_):
        for child in tasks.get_children(): tasks.remove(child)
        active=ws.get_active_window()
        for win in [x for x in ws.get_windows() if not x.is_skip_tasklist() and x.get_window_type() in (Wnck.WindowType.NORMAL,Wnck.WindowType.DIALOG)][:8]:
            btn=Gtk.Button();btn.set_tooltip_text(win.get_name())
            pix=win.get_icon()
            im=Gtk.Image.new_from_pixbuf(pix.scale_simple(icon,icon,2)) if pix else image("application-x-executable")
            btn.add(im)
            if active and win.get_xid()==active.get_xid(): btn.get_style_context().add_class("active")
            def activate(_btn,w=win):
                now=Gtk.get_current_event_time()
                if not now: now=GdkX11.x11_get_server_time(bar.get_window())
                if w.is_active() and not w.is_minimized(): w.minimize()
                else: w.activate(now)
            btn.connect("clicked",activate);tasks.pack_start(btn,False,False,0)
        tasks.show_all()
    ws.force_update()
    for signal in ("window-opened","window-closed","active-window-changed"):
        ws.connect(signal,rebuild_tasks)
    rebuild_tasks()
    bar.show_all();bar.move(0,height-bar_h)
    def strut():
        xid=bar.get_window().get_xid()
        values=[0,0,0,bar_h,0,0,0,0,0,0,0,width-1]
        for prop,v in (("_NET_WM_STRUT_PARTIAL",values),("_NET_WM_STRUT",values[:4])):
            subprocess.run(["xprop","-id",str(xid),"-f",prop,"32c","-set",prop,", ".join(map(str,v))],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        return False
    GLib.idle_add(strut)
    print("== Droi shell ready: %sx%s scale=%s%%"%(width,height,percent),flush=True)
    Gtk.main()
    return 0

if __name__=="__main__":
    sys.exit(main())
