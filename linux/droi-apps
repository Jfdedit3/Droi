#!/bin/bash
set -euo pipefail
root_cmd=()
if [ "$(id -u)" != 0 ]; then root_cmd=(/usr/local/bin/droiddeck-root); fi
export TMPDIR=/tmp
usage() {
  cat <<'HELP'
Droi : gestionnaire d’applications Linux
  droi-apps status
  droi-apps install chatgpt latest
  droi-apps install chatgpt VERSION SHA256 [FICHIER_DEB]
  droi-apps install opencode latest
  droi-apps install opencode VERSION
  droi-apps defaults
  droi-apps setup
  droi-apps install brave latest
  droi-apps install brave VERSION
  droi-apps shortcuts
ChatGPT : SHA-256 attendu obtenu depuis une source de confiance.
Brave : installe la version stable ARM64 via le dépôt APT officiel signé.
Les applications manquantes sont installées au premier démarrage.
HELP
}
shortcuts() {
  local dir="$HOME/.local/share/applications"
  local bin=/usr/local/bin
  if [ "$(id -u)" != 0 ]; then bin="$HOME/.local/bin"; fi
  mkdir -p "$dir" "$bin"
  cat > "$bin/chatgpt" <<'LAUNCH'
#!/bin/bash
set -eu
if [ ! -x /usr/bin/chatgpt ] || [ "$(dpkg-query -W -f='${Status}' chatgpt 2>/dev/null || true)" != "install ok installed" ]; then
  # A click on the launcher is an explicit request to install the native app.
  if [ -t 0 ]; then exec /usr/bin/droi-apps install-launch-chatgpt; fi
  if command -v konsole >/dev/null; then exec konsole -e /usr/bin/droi-apps install-launch-chatgpt; fi
  if command -v xfce4-terminal >/dev/null; then exec xfce4-terminal -x /usr/bin/droi-apps install-launch-chatgpt; fi
  if command -v qterminal >/dev/null; then exec qterminal -e /usr/bin/droi-apps install-launch-chatgpt; fi
  if command -v xterm >/dev/null; then exec xterm -e /usr/bin/droi-apps install-launch-chatgpt; fi
  echo "Aucun terminal graphique disponible. Lance droi-apps install chatgpt latest." >&2
  exit 1
fi
export TMPDIR=/tmp
export ELECTRON_OZONE_PLATFORM_HINT=x11
export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
mkdir -p "$CODEX_HOME"
chmod 700 "$CODEX_HOME"
exec /usr/bin/droi-chromium-launch chatgpt "$@"
LAUNCH
  chmod 0755 "$bin/chatgpt"
  cat > "$dir/droi-chatgpt.desktop" <<ENTRY
[Desktop Entry]
Type=Application
Name=ChatGPT
Exec="$bin/chatgpt"
Icon=chatgpt
Terminal=false
Categories=Network;Office;
ENTRY
  cat > "$dir/droi-game-downloader.desktop" <<'ENTRY'
[Desktop Entry]
Type=Application
Name=Droi Game Downloader
Exec=/usr/bin/droi-game-downloader
Icon=folder-download
Terminal=false
Categories=Game;Network;
ENTRY
  cat > "$dir/droi-update.desktop" <<'ENTRY'
[Desktop Entry]
Type=Application
Name=Droi Update
Comment=Mises à jour du système Ubuntu
Exec=/usr/bin/droi-update
Icon=system-software-update
Terminal=false
Categories=System;Settings;
ENTRY
  rm -f -- "$dir/droi-chatgpt-web.desktop"
  cat > "$bin/droi-brave" <<'BRAVE'
#!/bin/bash
set -eu
terminal_run() {
  if [ -t 0 ]; then exec "$@"; fi
  if command -v konsole >/dev/null; then exec konsole -e "$@"; fi
  if command -v xfce4-terminal >/dev/null; then exec xfce4-terminal -x "$@"; fi
  if command -v qterminal >/dev/null; then exec qterminal -e "$@"; fi
  if command -v xterm >/dev/null; then exec xterm -e "$@"; fi
  echo "Ouvre un terminal pour lancer Brave." >&2
  exit 1
}
if [ ! -x /usr/bin/brave-browser ] || [ "$(dpkg-query -W -f='${Status}' brave-browser 2>/dev/null || true)" != "install ok installed" ]; then
  terminal_run /usr/bin/droi-apps install-launch-brave "$@"
fi
exec /usr/bin/droi-chromium-launch brave "$@"
BRAVE
  chmod 0755 "$bin/droi-brave"
  cat > "$dir/droi-brave.desktop" <<ENTRY
[Desktop Entry]
Type=Application
Name=Brave
Exec="$bin/droi-brave" %U
Icon=brave-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
ENTRY
  if [ -x /usr/bin/brave-browser ]; then
    XDG_CURRENT_DESKTOP=Droi DE=generic xdg-settings set default-web-browser droi-brave.desktop || true
    for mime in text/html x-scheme-handler/http x-scheme-handler/https; do
      XDG_CURRENT_DESKTOP=Droi DE=generic xdg-mime default droi-brave.desktop "$mime" || true
    done
  fi
}
installed_package() {
  [ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null || true)" = "install ok installed" ]
}
opencode_ready() {
  [ -f /usr/local/lib/droi-opencode/native-version ] && [ -x /usr/local/lib/droi-opencode/bin/opencode ] && [ ! -L /usr/local/lib/droi-opencode/bin/opencode ]
}
defaults_needed() {
  installed_package chatgpt && [ -x /usr/bin/chatgpt ] &&
  installed_package brave-browser && [ -x /usr/bin/brave-browser ] &&
  opencode_ready &&
  [ -x "$HOME/.local/share/droi/depotdownloader/DepotDownloader_3.4.0/DepotDownloader" ]
}
install_defaults() {
  mkdir -p "$HOME/.cache/droi"
  exec 7>"$HOME/.cache/droi/defaults.lock"
  flock -n 7 || { echo "Installation initiale déjà en cours."; return 1; }
  umask 077
  export DEBIAN_FRONTEND=noninteractive
  local failed=0
  exec > >(tee -a "$HOME/.cache/droi/default-apps.log") 2>&1
  echo "=== Droi : installation des applications par défaut ==="
  echo "== Vérification Brave =="
  if ! installed_package brave-browser || [ ! -x /usr/bin/brave-browser ]; then
    /usr/bin/droi-apps install brave latest || failed=1
  fi
  echo "== Vérification ChatGPT =="
  if ! installed_package chatgpt || [ ! -x /usr/bin/chatgpt ]; then
    /usr/bin/droi-apps install chatgpt latest || failed=1
  fi
  echo "== Vérification OpenCode =="
  if ! opencode_ready; then
    /usr/bin/droi-apps install opencode latest || failed=1
  fi
  echo "== Vérification DepotDownloader =="
  if [ ! -x "$HOME/.local/share/droi/depotdownloader/DepotDownloader_3.4.0/DepotDownloader" ]; then
    /usr/bin/droi-game-downloader --install-engine || failed=1
  fi
  shortcuts
  if [ "$failed" = 0 ]; then echo "Toutes les applications par défaut sont installées."
  else echo "Installation partielle. Relance droi-apps defaults pour réessayer."; fi
  return "$failed"
}
# One-time system setup is versioned independently from the APK.
setup_marker="$HOME/.local/state/droi/first-setup-v1"
system_marker="$HOME/.local/state/droi/system-setup-v1"
setup_needed() { [ ! -f "$setup_marker" ] || ! command -v metacity >/dev/null || ! defaults_needed; }
system_setup() (
  mkdir -p "$HOME/.cache/droi" "$(dirname "$setup_marker")"
  exec 6>"$HOME/.cache/droi/setup.lock"
  flock -n 6 || { echo "Configuration initiale déjà en cours."; exit 1; }
  umask 077
  export DEBIAN_FRONTEND=noninteractive
  if [ ! -f "$setup_marker" ] && [ ! -f "$system_marker" ]; then
    (
      exec 8>"$HOME/.cache/droi/apps.lock"
      flock -w 600 8 || { echo "Un autre gestionnaire Droi utilise APT."; exit 1; }
      apt_cmd=("${root_cmd[@]}" apt-get -o DPkg::Lock::Timeout=600 -o Acquire::Retries=3)
      echo "== SETUP 1/5 Actualisation des dépôts Ubuntu =="
      "${apt_cmd[@]}" -o APT::Update::Error-Mode=any update || exit 1
      echo "== SETUP 2/5 Dépendances du bureau et outils système =="
      "${apt_cmd[@]}" -y --no-remove -o Dpkg::Options::=--force-confold install \
        ca-certificates curl wget unzip zip xz-utils zstd util-linux \
        python3 python3-gi python3-gi-cairo python3-cairo gir1.2-gtk-3.0 gir1.2-wnck-3.0 \
        openbox metacity xwayland xauth x11-utils x11-xserver-utils dbus-x11 xdg-utils \
        desktop-file-utils shared-mime-info fonts-noto-core fonts-dejavu-core \
        libgl1-mesa-dri libglx-mesa0 nodejs npm git aria2 || exit 1
      echo "== SETUP 3/5 Mises à jour Ubuntu (sécurité et paquets) =="
      "${apt_cmd[@]}" -y --with-new-pkgs --no-remove -o Dpkg::Options::=--force-confold upgrade || exit 1
      "${apt_cmd[@]}" check || exit 1
    ) || exit 1
    printf "%s\n" complete > "$system_marker.tmp" || exit 1
    mv -f "$system_marker.tmp" "$system_marker" || exit 1
  elif ! command -v metacity >/dev/null; then
    (
      exec 8>"$HOME/.cache/droi/apps.lock"
      flock -w 600 8 || exit 1
      echo "== SETUP 2/5 Gestionnaire de fenêtres compatible Steam =="
      "${root_cmd[@]}" apt-get -o DPkg::Lock::Timeout=600 -o Acquire::Retries=3 -o APT::Update::Error-Mode=any update || exit 1
      "${root_cmd[@]}" apt-get -o DPkg::Lock::Timeout=600 -o Acquire::Retries=3 -y --no-remove install metacity || exit 1
    ) || exit 1
  fi
  echo "== SETUP 4/5 Brave, ChatGPT, OpenCode, DepotDownloader =="
  # defaults manages its own locks. Do not hold apps.lock across this call.
  local app_result=0
  /usr/bin/droi-apps defaults || app_result=$?
  echo "== SETUP 5/5 Vérification de l'installation =="
  "${root_cmd[@]}" apt-get -o DPkg::Lock::Timeout=600 check || exit 1
  /usr/bin/droi-apps shortcuts || exit 1
  if [ "$app_result" != 0 ] || ! defaults_needed; then
    echo "Ubuntu est prêt. Certaines applications restent à installer : droi-apps defaults."
    exit 3
  fi
  printf '%s\n' "complete" > "$setup_marker.tmp"
  mv -f "$setup_marker.tmp" "$setup_marker"
  echo "Configuration initiale terminée. Le bureau va s'ouvrir."
)
case "${1:-}" in
  setup-needed) if setup_needed; then exit 0; else exit 1; fi ;;
  setup) system_setup ;;
  defaults-needed) if defaults_needed; then exit 1; else exit 0; fi ;;
  defaults) install_defaults ;;
  shortcuts) shortcuts ;;
  install-launch-chatgpt)
    echo "Installation de ChatGPT Desktop officiel (ARM64)"
    if ! /usr/bin/droi-apps install chatgpt latest; then
      echo "Échec de l'installation. Consulte les erreurs ci-dessus."
      if [ -t 0 ]; then read -r -p "Entrée pour fermer..." _; fi
      exit 1
    fi
    echo "Installation terminée."
    if [ "$(id -u)" = 0 ]; then exec /usr/local/bin/chatgpt; else exec "$HOME/.local/bin/chatgpt"; fi
    ;;
  install-launch-brave)
    echo "Installation de Brave stable officiel (ARM64)"
    if ! /usr/bin/droi-apps install brave latest; then
      echo "Échec de l'installation de Brave."
      if [ -t 0 ]; then read -r -p "Entrée pour fermer..." _; fi
      exit 1
    fi
    shift
    if [ "$(id -u)" = 0 ]; then exec /usr/local/bin/droi-brave "$@"; else exec "$HOME/.local/bin/droi-brave" "$@"; fi
    ;;
  status)
    dpkg-query -W -f='${Package} ${Version}\n' chatgpt brave-browser 2>/dev/null || true
    /usr/bin/opencode --version || true
    ;;
  install)
    app="${2:-}"
    version="${3:-}"
    [ -n "$version" ] || { usage; exit 2; }
    if [ "$app:$version" != "chatgpt:latest" ] && [ "$app:$version" != "brave:latest" ] && [ "$app:$version" != "opencode:latest" ]; then
      [[ "$version" =~ ^[0-9][A-Za-z0-9.+:~_-]*$ ]] || { echo "Version invalide" >&2; exit 2; }
    fi
    mkdir -p "$HOME/.cache/droi"
    exec 8>"$HOME/.cache/droi/apps.lock"
    flock 8
    case "$app" in
      chatgpt)
        digest="${4:-}"
        if [ "$version" != latest ]; then
          [[ "$digest" =~ ^[a-fA-F0-9]{64}$ ]] || { echo "SHA-256 attendu obligatoire" >&2; exit 2; }
        else
          [ -z "$digest" ] && [ -z "${5:-}" ] || { echo "latest utilise uniquement le téléchargement officiel" >&2; exit 2; }
        fi
        [ "$(dpkg --print-architecture)" = arm64 ] || { echo "Ubuntu ARM64 requis" >&2; exit 1; }
        temp="$(mktemp -d)"
        trap 'rm -rf -- "$temp"' EXIT
        deb="$temp/chatgpt-arm64.deb"
        if [ -n "${5:-}" ]; then
          cp -- "$5" "$deb"
        else
          curl --proto '=https' --proto-redir '=https' -fL --retry 3 \
            https://persistent.oaistatic.com/codex-app-prod/linux/deb/latest/chatgpt_arm64.deb -o "$deb"
        fi
        if [ "$version" != latest ]; then
          printf '%s  %s\n' "$digest" "$deb" | sha256sum -c -
        fi
        [ "$(dpkg-deb -f "$deb" Package)" = chatgpt ]
        [ "$(dpkg-deb -f "$deb" Architecture)" = arm64 ]
        actual_version="$(dpkg-deb -f "$deb" Version)"
        [ -n "$actual_version" ]
        [ "$version" = latest ] || [ "$actual_version" = "$version" ] || { echo "Version du paquet différente de celle demandée" >&2; exit 1; }
        echo "Installation du paquet officiel ChatGPT $actual_version (arm64)"
        chmod 755 "$temp"; chmod 644 "$deb"
        "${root_cmd[@]}" apt-get -o Acquire::Retries=3 update
        "${root_cmd[@]}" apt-get -o DPkg::Lock::Timeout=600 install -y "$deb"
        [ "$(dpkg-query -W -f='${Status}' chatgpt)" = "install ok installed" ]
        [ -x /usr/bin/chatgpt ]
        shortcuts
        ;;
      brave)
        [ "$(dpkg --print-architecture)" = arm64 ] || { echo "Ubuntu ARM64 requis" >&2; exit 1; }
        temp="$(mktemp -d)"
        trap 'rm -rf -- "$temp"' EXIT
        base=https://brave-browser-apt-release.s3.brave.com
        curl --proto '=https' --proto-redir '=https' -fL --retry 3 "$base/brave-browser-archive-keyring.gpg" -o "$temp/brave.gpg"
        curl --proto '=https' --proto-redir '=https' -fL --retry 3 "$base/brave-browser.sources" -o "$temp/brave.sources"
        "${root_cmd[@]}" install -Dm644 "$temp/brave.gpg" /usr/share/keyrings/brave-browser-archive-keyring.gpg
        "${root_cmd[@]}" install -Dm644 "$temp/brave.sources" /etc/apt/sources.list.d/brave-browser-release.sources
        "${root_cmd[@]}" apt-get -o Acquire::Retries=3 update
        package=brave-browser
        [ "$version" = latest ] || package="brave-browser=$version"
        "${root_cmd[@]}" apt-get -o DPkg::Lock::Timeout=600 install -y "$package"
        [ "$(dpkg-query -W -f='${Status}' brave-browser)" = "install ok installed" ]
        [ -x /usr/bin/brave-browser ]
        shortcuts
        ;;
      opencode)
        if ! command -v npm >/dev/null; then
          "${root_cmd[@]}" apt-get update
          "${root_cmd[@]}" apt-get -o DPkg::Lock::Timeout=600 install -y nodejs npm
        fi
        [ "$(dpkg --print-architecture)" = arm64 ] || { echo "Ubuntu ARM64 requis" >&2; exit 1; }
        prefix=/usr/local/lib/droi-opencode
        # Select the glibc ARM64 package explicitly, bypassing the generic
        # npm postinstall (which can fail to spawn the binary under PRoot).
        npm_flags=(--registry=https://registry.npmjs.org/ --fetch-retries=2 --fetch-timeout=120000)
        if [ "$version" = latest ]; then
          version=$(npm "${npm_flags[@]}" view @opencode/cli@latest version) || exit 1
        fi
        [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]] || { echo "Version OpenCode invalide : $version" >&2; exit 1; }
        if opencode_ready && [ "$(cat "$prefix/native-version")" = "$version" ]; then
          echo "OpenCode $version déjà installé."
          exit 0
        fi
        temp=$(mktemp -d)
        trap 'rm -rf -- "$temp"' EXIT
        echo "OpenCode $version : téléchargement NPM Linux ARM64 glibc"
        npm "${npm_flags[@]}" install --prefix "$temp" --ignore-scripts --no-audit --no-fund --no-save --omit=optional "@opencode/cli-linux-arm64@$version" || exit 1
        native="$temp/node_modules/@opencode/cli-linux-arm64/bin/opencode"
        [ -f "$native" ] || { echo "Binaire ARM64 absent du paquet NPM" >&2; exit 1; }
        chmod 755 "$native" || exit 1
        echo "OpenCode : vérification directe du binaire ARM64 (30 s maximum)"
        python3 - "$native" "$version" <<'PYVERIFY'
import subprocess, sys
try:
    result = subprocess.run([sys.argv[1], "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=30, check=True)
    print(result.stdout.strip(), flush=True)
    if sys.argv[2] not in result.stdout:
        raise RuntimeError("Version du binaire différente du paquet demandé")
except (OSError, subprocess.SubprocessError, RuntimeError) as error:
    print("OpenCode ARM64 :", error, file=sys.stderr, flush=True)
    sys.exit(1)
PYVERIFY
        [ "$?" = 0 ] || exit 1
        "${root_cmd[@]}" mkdir -p "$prefix/bin" || exit 1
        "${root_cmd[@]}" install -m755 "$native" "$prefix/bin/.opencode-new" || exit 1
        "${root_cmd[@]}" mv -Tf "$prefix/bin/.opencode-new" "$prefix/bin/opencode" || exit 1
        printf '%s\n' "$version" > "$temp/version"
        "${root_cmd[@]}" install -m644 "$temp/version" "$prefix/.native-version-new" || exit 1
        "${root_cmd[@]}" mv -Tf "$prefix/.native-version-new" "$prefix/native-version" || exit 1
        echo "OpenCode $version installé et vérifié."
        ;;
      *) usage; exit 2 ;;
    esac
    ;;
  *) usage; exit 2 ;;
esac
