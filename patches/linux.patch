+def droi_software_gl(command, env):
+    mode = env.get("DROI_GRAPHICS_MODE", "auto")
+    program = env.get("DROIDDECK_DESKTOP_PROGRAM") or (command[2] if len(command) > 2 else "")
+    # An explicit performance choice always wins over the default game profile.
+    return mode == "compatibility" or (mode == "auto" and Path(program).name.casefold() == "geometrydash.exe")
+
