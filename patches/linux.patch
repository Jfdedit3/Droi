+def desktop_tools(root):
+    # Registered Valve wrappers do not mean a Proton depot is installed.
+    c = compat()
+    available = tools(root)
+    own = dict(c["OWN_TOOLS"])
+    return {name: entry for name, entry in available.items()
+            if name not in own or c["find_source"](root, own[name], runnable=True) is not None}
+
+
+def desktop_choice(root, available):
+    # Android can save the user's Proton choice before Steam is ever started.
+    c = compat()
+    state = c["read_json"](STATE)
+    request = c["read_json"](os.path.join(os.path.dirname(STATE), "request.json"))
+    if isinstance(request.get("seq"), int) and request["seq"] > (state.get("applied") or 0):
+        name = c["requested_tool"](request, c["tool_catalog"](root))
+        if name in available:
+            return name
+    default = state.get("default")
+    return default if default in available else None
+
+
