@@ -1439,6 +1439,30 @@ object ComponentsManager {
         refresh: () -> List<CatalogItem>,
     ): CatalogItem? = catalogMatch(cached(), file, release) ?: catalogMatch(refresh(), file, release)
 
+    internal fun downloadForProton(context: Context, dir: String, progress: (String, Int) -> Unit) {
+        val proton = protons(context).first { it.dir.name == dir }
+        progress("Recherche des composants pour ${proton.name}", -1)
+        val entries = catalog(context, false).items.ifEmpty { catalog(context, true).items }
+        check(entries.isNotEmpty()) { "Catalogue des composants indisponible" }
+        for (comp in COMPONENTS) {
+            if (!supports(proton, comp) || runtimeManaged(context, comp)) continue
+            val item = if (comp == "dxvk" && hardwareDxvk(context)) {
+                val pinned = pinnedAutoDxvk(context) ?: continue
+                entries.firstOrNull { it.comp == comp && it.file == pinned }
+            } else {
+                val line = if (comp == "fex") ComponentUpdates.fexLine(proton) else {
+                    val ec = arm64ec(context, proton, comp) ?: continue
+                    ComponentUpdates.line(comp, ec)
+                }
+                ComponentUpdates.pick(entries, line, emptySet())
+            } ?: continue
+            if (!isStored(context, item.file)) {
+                download(context, item) { percent -> progress("${proton.name} · ${item.file}", percent) }
+            }
+        }
+    }
+
+    @Synchronized
     fun download(context: Context, item: CatalogItem, progress: (Int) -> Unit): Package {
         require(allowedDownload(item.url)) { context.getString(R.string.cmgr_nightlies_only) }
         require(Hashes.isGithubSha256(item.digest)) { context.getString(R.string.cmgr_list_predates_checksums) }
