diff --git a/app/src/main/java/com/droiddeck/launcher/ui/WineProcessPage.kt b/app/src/main/java/com/droiddeck/launcher/ui/WineProcessPage.kt
new file mode 100644
index 0000000..99e82a2
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/ui/WineProcessPage.kt
@@ -0,0 +1,62 @@
+package com.droiddeck.launcher.ui
+
+import android.os.Process
+import android.system.Os
+import androidx.compose.foundation.focusable
+import androidx.compose.foundation.layout.Column
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.produceState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.res.stringResource
+import com.droiddeck.launcher.R
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withContext
+import java.io.File
+
+private fun processList(): List<Pair<Int, String>> {
+    val uid = Process.myUid()
+    val processes = mutableListOf<Pair<Int, String>>()
+    for (dir in File("/proc").listFiles().orEmpty()) {
+        val pid = dir.name.toIntOrNull() ?: continue
+        val name = runCatching {
+            if (Os.stat(dir.path).st_uid != uid) return@runCatching null
+            val args = File(dir, "cmdline").readText().split('\u0000')
+            val program = args.first().substringAfterLast('/').substringAfterLast('\\')
+            val comm = File(dir, "comm").readText().trim()
+            when {
+                program.endsWith(".exe", true) -> program
+                program in wineLoaders -> args.drop(1).firstOrNull { it.endsWith(".exe", true) }
+                    ?.substringAfterLast('/')?.substringAfterLast('\\') ?: program
+                comm.endsWith(".exe", true) || comm in wineLoaders -> comm
+                else -> null
+            }
+        }.getOrNull()
+        if (name != null) processes.add(pid to name)
+    }
+    return processes.sortedBy { it.first }
+}
+
+private val wineLoaders = setOf("wine", "wine64", "wineserver", "wineserver64", "wine-preloader", "wine64-preloader")
+
+@Composable
+internal fun WineProcessPage(modifier: Modifier) {
+    val processes by produceState<List<Pair<Int, String>>?>(null) {
+        while (true) {
+            value = withContext(Dispatchers.IO) { processList() }
+            delay(1000)
+        }
+    }
+    SettingsGroup(stringResource(R.string.drawer_wine_processes)) {
+        Column(modifier.focusable()) {
+            val rows = processes
+            when {
+                rows == null -> Text("…")
+                rows.isEmpty() -> Text(stringResource(R.string.drawer_wine_empty))
+                else -> rows.forEach { (pid, name) -> SettingsRow(name, "PID $pid") {} }
+            }
+        }
+    }
+}
