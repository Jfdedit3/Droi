new file mode 100644
index 0000000..c9296c1
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/DesktopLauncherActivity.kt
@@ -0,0 +1,74 @@
+package com.droiddeck.launcher
+
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.runtime.saveable.rememberSaveable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.droiddeck.launcher.ui.DroidDeckTheme
+import com.droiddeck.launcher.ui.MenuItem
+import com.droiddeck.launcher.ui.SettingsGroup
+import com.droiddeck.launcher.ui.TabStrip
+import android.content.Intent
+import android.os.Bundle
+import android.widget.Toast
+import com.droiddeck.launcher.session.SessionService
+
+class DesktopLauncherActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContent {
+            DroidDeckTheme {
+                var tab by rememberSaveable { mutableIntStateOf(0) }
+                var automatic by remember { mutableStateOf(DroiUpdates.isEnabled(this)) }
+                androidx.activity.compose.BackHandler(enabled = tab != 0) { tab = 0 }
+                Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+                    Column(Modifier.verticalScroll(rememberScrollState()).padding(20.dp),
+                        verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                        Text("Droi Desktop", style = MaterialTheme.typography.headlineMedium)
+                        TabStrip(listOf("Bureaux", "Paramètres"), tab, { tab = it })
+                        if (tab == 0) {
+                            SettingsGroup("Bureaux Linux") {
+                                MenuItem("Ubuntu", false, detail = "KDE Plasma") { launchUbuntu() }
+                            }
+                        } else {
+                            SettingsGroup("Mises à jour de Droi") {
+                                MenuItem("Télécharger automatiquement les nouveaux APK", automatic) {
+                                    automatic = !automatic
+                                    DroiUpdates.setEnabled(this@DesktopLauncherActivity, automatic)
+                                    if (automatic) DroiUpdates.check(this@DesktopLauncherActivity, force = true, report = ::showUpdateStatus)
+                                }
+                                val message by DroiUpdates.status.collectAsState()
+                                val available by DroiUpdates.ready.collectAsState()
+                                if (message.isNotEmpty()) Text(message)
+                                if (available > 0) MenuItem("Installer la mise à jour", false) {
+                                    DroiUpdates.install(this@DesktopLauncherActivity)
+                                }
+                                MenuItem("Vérifier maintenant", false) {
+                                    DroiUpdates.check(this@DesktopLauncherActivity, force = true, manual = true, report = ::showUpdateStatus)
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        DroiUpdates.check(this)
+    }
+
+    private fun launchUbuntu() {
+        startActivity(Intent(this, SessionActivity::class.java)
+            .putExtra(SessionService.EXTRA_MODE, SessionService.MODE_DESKTOP))
+    }
+
+    private fun showUpdateStatus(message: String) {
+        runOnUiThread {
+            if (!isDestroyed && !isFinishing) Toast.makeText(this, message, Toast.LENGTH_LONG).show()
+        }
+    }
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/DroiUpdates.kt b/app/src/main/java/com/droiddeck/launcher/DroiUpdates.kt
new file mode 100644
index 0000000..8243692
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/DroiUpdates.kt
@@ -0,0 +1,151 @@
+package com.droiddeck.launcher
+
+import android.app.DownloadManager
+import android.content.Context
+import androidx.core.content.FileProvider
+import com.droiddeck.launcher.core.Downloader
+import kotlinx.coroutines.flow.MutableStateFlow
+import java.io.File
+import android.content.BroadcastReceiver
+import android.content.Intent
+import android.util.Log
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.atomic.AtomicBoolean
+
+internal object DroiUpdates {
+    private const val REPO = "Jfdedit3/Droi"
+    private const val ASSET = "Droi-Desktop-arm64.apk"
+    private const val MIME_TYPE = "application/vnd.android.package-archive"
+    private const val CHECK_INTERVAL = 6 * 60 * 60 * 1000L
+    private val tagPattern = Regex("droi-(\\d+)")
+    val status = MutableStateFlow("")
+    val ready = MutableStateFlow(0)
+    private fun directory(context: Context) = File(context.cacheDir, "droi-updates")
+    private fun apk(context: Context, version: Int) = File(directory(context), "$version.apk")
+    private val busy = AtomicBoolean()
+
+    private fun prefs(context: Context) = context.getSharedPreferences("droi_updates", Context.MODE_PRIVATE)
+
+    fun isEnabled(context: Context) = prefs(context).getBoolean("automatic_download", false)
+
+    fun setEnabled(context: Context, enabled: Boolean) {
+        prefs(context).edit().putBoolean("automatic_download", enabled).apply()
+    }
+
+    fun check(context: Context, force: Boolean = false, manual: Boolean = false, report: (String) -> Unit = {}) {
+        val app = context.applicationContext
+        removeInstalledDownload(app)
+        if (!manual && !isEnabled(app)) return
+        val saved = prefs(app)
+        val now = System.currentTimeMillis()
+        if (!force && now - saved.getLong("last_check", 0) in 0 until CHECK_INTERVAL) return
+        if (!busy.compareAndSet(false, true)) {
+            report("Vérification déjà en cours.")
+            return
+        }
+
+        status.value = "Vérification…"
+        Thread({
+            try {
+                val release = latestRelease()
+                val result = when {
+                    release == null || release.version <= BuildConfig.VERSION_CODE -> "Droi est à jour."
+                    !manual && !isEnabled(app) -> "Téléchargement automatique désactivé."
+                    else -> download(app, release)
+                }
+                saved.edit().putLong("last_check", now).apply()
+                status.value = result
+                report(result)
+            } catch (error: Exception) {
+                Log.w("DroiUpdates", "Update check failed", error)
+                status.value = "Échec de la mise à jour. Tu peux réessayer."
+                report(status.value)
+            } finally {
+                busy.set(false)
+            }
+        }, "droi-updates").start()
+    }
+
+    @Synchronized
+    fun removeInstalledDownload(context: Context) {
+        val saved = prefs(context)
+        val cached = saved.getInt("cached_version", 0)
+        if (cached > BuildConfig.VERSION_CODE && apk(context, cached).isFile) {
+            ready.value = cached
+        } else {
+            if (cached > 0) apk(context, cached).delete()
+            saved.edit().remove("cached_version").apply()
+            ready.value = 0
+        }
+        val version = saved.getInt("download_version", 0)
+        val id = saved.getLong("download_id", -1)
+        if (id < 0 || version !in 1..BuildConfig.VERSION_CODE) return
+        val manager = context.getSystemService(DownloadManager::class.java) ?: return
+        runCatching {
+            manager.remove(id)
+            saved.edit().remove("download_id").remove("download_version").apply()
+        }.onFailure { Log.w("DroiUpdates", "Could not clean up installed APK", it) }
+    }
+
+    private data class Release(val tag: String, val version: Int, val digest: String, val size: Long)
+
+    private fun latestRelease(): Release? {
+        val connection = URL("https://api.github.com/repos/$REPO/releases/latest").openConnection() as HttpURLConnection
+        try {
+            connection.connectTimeout = 12_000
+            connection.readTimeout = 12_000
+            connection.setRequestProperty("Accept", "application/vnd.github+json")
+            val status = connection.responseCode
+            if (status == 404) return null
+            check(status == 200) { "GitHub HTTP $status" }
+            val data = JSONObject(connection.inputStream.bufferedReader().use { it.readText() })
+            val tag = data.getString("tag_name")
+            val version = tagPattern.matchEntire(tag)?.groupValues?.get(1)?.toIntOrNull() ?: return null
+            val assets = data.getJSONArray("assets")
+            val asset = (0 until assets.length()).map { assets.getJSONObject(it) }.first {
+                it.optString("name") == ASSET && it.optString("state") == "uploaded"
+            }
+            return Release(tag, version, asset.getString("digest").removePrefix("sha256:"), asset.getLong("size"))
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun download(context: Context, release: Release): String {
+        val target = apk(context, release.version)
+        if (ready.value == release.version && target.isFile) return "Mise à jour prête."
+        val folder = directory(context)
+        check(folder.isDirectory || folder.mkdirs())
+        val partial = File(folder, "${release.version}.part")
+        status.value = "Téléchargement…"
+        val url = "https://github.com/$REPO/releases/download/${release.tag}/$ASSET"
+        val ok = Downloader.downloadFile(url, partial, true, release.digest) { fraction ->
+            if (fraction in 0f..1f) status.value = "Téléchargement : ${(fraction * 100).toInt()} %"
+        }
+        check(ok && partial.length() == release.size && partial.renameTo(target))
+        prefs(context).edit().putInt("cached_version", release.version).apply()
+        ready.value = release.version
+        folder.listFiles()?.filter { it != target }?.forEach { it.delete() }
+        return "Mise à jour prête."
+    }
+
+    fun install(context: Context) {
+        val file = apk(context, ready.value)
+        if (!file.isFile) {
+            ready.value = 0
+            status.value = "Vérifie à nouveau pour télécharger l’APK."
+            return
+        }
+        val uri = FileProvider.getUriForFile(context, "${context.packageName}.logs", file)
+        context.startActivity(Intent(Intent.ACTION_VIEW).setDataAndType(uri, MIME_TYPE)
+            .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION))
+    }
+}
+
+class DroiUpdateInstalledReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action == Intent.ACTION_MY_PACKAGE_REPLACED) DroiUpdates.removeInstalledDownload(context)
+    }
+}
