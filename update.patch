diff --git a/app/src/main/assets/droi-launch/desktop.sh b/app/src/main/assets/droi-launch/desktop.sh
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/app/src/main/assets/droi-launch/desktop.sh
@@ -0,0 +1,170 @@
+#!/bin/bash
+set -euo pipefail
+
+web_port=$1
+vnc_port=$2
+display_number=$3
+read -r password
+
+export HOME=/root USER=root LOGNAME=root LANG=C.UTF-8
+export DISPLAY=:$display_number XDG_RUNTIME_DIR=/tmp/droi-runtime-$display_number
+export NO_AT_BRIDGE=1 LIBGL_ALWAYS_SOFTWARE=1
+unset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS
+
+mkdir -p "$HOME" /tmp/.X11-unix "$XDG_RUNTIME_DIR"
+chmod 1777 /tmp/.X11-unix
+chmod 700 "$XDG_RUNTIME_DIR"
+export XAUTHORITY="$XDG_RUNTIME_DIR/Xauthority"
+xauth -f "$XAUTHORITY" add "$DISPLAY" MIT-MAGIC-COOKIE-1 "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
+printf '%s\n' "$password" | droi-vncpasswd -f > "$XDG_RUNTIME_DIR/passwd"
+chmod 600 "$XDG_RUNTIME_DIR/passwd"
+unset password
+
+# PRoot cannot reliably unwind a thread if libgcc_s is loaded lazily.
+gcc_preload=
+for lib in /lib/aarch64-linux-gnu/libgcc_s.so.1 /usr/lib/aarch64-linux-gnu/libgcc_s.so.1 /lib64/libgcc_s.so.1 /usr/lib64/libgcc_s.so.1; do
+    if [ -r "$lib" ]; then gcc_preload="$lib"; break; fi
+done
+run_x() {
+    if [ -n "$gcc_preload" ]; then
+        exec env LD_PRELOAD="$gcc_preload${LD_PRELOAD:+:$LD_PRELOAD}" "$@"
+    else
+        exec "$@"
+    fi
+}
+x_pid=
+vnc_pid=
+web_pid=
+desktop_pid=
+cleanup() {
+    for pid in "$desktop_pid" "$web_pid" "$vnc_pid" "$x_pid"; do
+        if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; fi
+    done
+    rm -rf -- "$XDG_RUNTIME_DIR"
+}
+trap cleanup EXIT
+trap 'exit 0' TERM INT
+wait_x() {
+    for _ in {1..20}; do
+        if ! kill -0 "$x_pid" 2>/dev/null; then return 1; fi
+        if timeout 2 xdpyinfo >/dev/null 2>&1; then return 0; fi
+        sleep .25
+    done
+    return 1
+}
+start_fallback() {
+    echo "Droi: switching to Xvfb + x11vnc"
+    if ! command -v Xvfb >/dev/null || ! command -v x11vnc >/dev/null; then
+        echo "Droi: installing missing display packages in existing distribution"
+        if command -v apt-get >/dev/null; then
+            timeout 160 bash -c 'dpkg --configure -a && apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=15 -o Acquire::https::Timeout=15 update && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=15 -o Acquire::https::Timeout=15 install -y --no-install-recommends xvfb x11vnc'
+        elif command -v dnf >/dev/null; then
+            timeout 160 dnf -y --setopt=timeout=15 --setopt=retries=1 --setopt=install_weak_deps=False install xorg-x11-server-Xvfb x11vnc
+        else
+            echo "Droi: no supported package manager" >&2
+            return 1
+        fi
+    fi
+    run_x Xvfb "$DISPLAY" -screen 0 1280x720x24 -nolock -nolisten tcp \
+        -extension MIT-SHM -extension GLX -auth "$XAUTHORITY" &
+    x_pid=$!
+    wait_x || { echo "Droi: Xvfb failed" >&2; return 1; }
+    run_x x11vnc -display "$DISPLAY" -auth "$XAUTHORITY" -localhost \
+        -rfbport "$vnc_port" -rfbauth "$XDG_RUNTIME_DIR/passwd" -forever -shared -noshm -noxdamage &
+    vnc_pid=$!
+    # Verify an RFB listener before opening the browser viewer.
+    for _ in {1..40}; do
+        kill -0 "$vnc_pid" 2>/dev/null || return 1
+        if (echo >/dev/tcp/127.0.0.1/"$vnc_port") 2>/dev/null; then return 0; fi
+        sleep .25
+    done
+    return 1
+}
+if [ "${DROI_FORCE_XVFB:-0}" != 1 ] && ! { command -v Xvfb >/dev/null && command -v x11vnc >/dev/null; }; then
+    echo "Droi: starting TigerVNC with PRoot compatibility settings"
+    run_x droi-xvnc "$DISPLAY" -localhost -interface 127.0.0.1 -UseIPv6=0 -nolock -nolisten tcp \
+        -extension MIT-SHM -extension GLX -rfbport "$vnc_port" \
+        -SecurityTypes VncAuth -PasswordFile "$XDG_RUNTIME_DIR/passwd" \
+        -auth "$XAUTHORITY" -geometry 1280x720 -depth 24 &
+    x_pid=$!
+fi
+if [ -z "$x_pid" ] || ! wait_x; then
+    if [ -n "$x_pid" ]; then
+        kill "$x_pid" 2>/dev/null || true
+        wait "$x_pid" 2>/dev/null || true
+        x_pid=
+        rm -f -- "/tmp/.X11-unix/X$display_number" "/tmp/.X${display_number}-lock"
+    fi
+    start_fallback || { echo "Droi: fallback display server failed" >&2; exit 1; }
+fi
+echo "Droi: starting XFCE session"
+export XDG_SESSION_TYPE=x11 GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb
+dbus-run-session -- xfce4-session &
+desktop_pid=$!
+# The APK carries an independent copy of the complete noVNC web client.
+web_root=/usr/local/share/droi/novnc
+if [ -f "$XDG_RUNTIME_DIR/novnc.tar.gz" ]; then
+    echo "Droi: preparing bundled noVNC assets"
+    mkdir -p "$XDG_RUNTIME_DIR/novnc"
+    python3 -m tarfile -e "$XDG_RUNTIME_DIR/novnc.tar.gz" "$XDG_RUNTIME_DIR/novnc"
+    web_root="$XDG_RUNTIME_DIR/novnc"
+elif [ ! -f "$web_root/vnc.html" ] && [ -f /usr/share/novnc/vnc.html ]; then
+    web_root=/usr/share/novnc
+fi
+for asset in vnc.html app/ui.js core/rfb.js; do
+    if [ ! -r "$web_root/$asset" ]; then
+        echo "Droi: missing noVNC asset $web_root/$asset" >&2
+        exit 1
+    fi
+done
+echo "Droi: starting noVNC viewer"
+# websockify normally relies on chdir/getcwd. Under PRoot these may expose
+# host paths; force an explicit guest web root for every static HTTP request.
+python3 -u - "$web_root" "$web_port" "$vnc_port" <<'PY' &
+import http.server
+import multiprocessing
+import sys
+# Python 3.14 defaults to forkserver, which cannot import /<stdin>.
+# Linux Websockify workers must inherit the patched HTTP handler.
+multiprocessing.set_start_method("fork", force=True)
+from websockify.websocketproxy import websockify_init
+
+root, web_port, vnc_port = sys.argv[1:]
+original = http.server.SimpleHTTPRequestHandler.translate_path
+def translate_path(self, path):
+    self.directory = root
+    return original(self, path)
+http.server.SimpleHTTPRequestHandler.translate_path = translate_path
+sys.argv = ["websockify", "--web", root, "127.0.0.1:" + web_port,
+            "127.0.0.1:" + vnc_port]
+websockify_init()
+PY
+web_pid=$!
+# Fail quickly with the precise HTTP error instead of polling for five minutes.
+python3 -u - "$web_port" <<'PY'
+import sys
+import time
+import urllib.request
+import urllib.error
+
+base = "http://127.0.0.1:" + sys.argv[1]
+for attempt in range(20):
+    try:
+        for path in ("/vnc.html", "/app/ui.js", "/core/rfb.js"):
+            with urllib.request.urlopen(base + path, timeout=1) as response:
+                if not response.read(32):
+                    raise RuntimeError("empty noVNC resource " + path)
+        print("Droi: noVNC assets verified", flush=True)
+        break
+    except urllib.error.HTTPError as error:
+        sys.exit("Droi: noVNC HTTP " + str(error.code) + " at " + error.url)
+    except OSError as error:
+        if attempt == 19:
+            sys.exit("Droi: noVNC server unavailable: " + str(error))
+        time.sleep(0.5)
+PY
+if [ -n "$vnc_pid" ]; then
+    wait -n "$x_pid" "$vnc_pid" "$desktop_pid" "$web_pid"
+else
+    wait -n "$x_pid" "$desktop_pid" "$web_pid"
+fi
