@@ -0,0 +1,46 @@
+package com.droiddeck.launcher
+
+import android.app.Activity
+import android.content.Intent
+import android.os.Bundle
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.droiddeck.launcher.session.SessionService
+
+class DesktopLauncherActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val menu = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            val inset = (24 * resources.displayMetrics.density).toInt()
+            setPadding(inset, inset, inset, inset)
+        }
+        menu.addView(TextView(this).apply {
+            text = "Bureaux Linux"
+            textSize = 24f
+        })
+        val desktops = listOf(
+            "ubuntu" to "Ubuntu · KDE Plasma",
+            "debian" to "Debian 13 · XFCE",
+            "fedora" to "Fedora 44 · XFCE",
+        )
+        for ((id, label) in desktops) {
+            menu.addView(Button(this).apply {
+                text = label
+                isAllCaps = false
+                setOnClickListener {
+                    val launch = if (id == "ubuntu") {
+                        Intent(this@DesktopLauncherActivity, SessionActivity::class.java)
+                            .putExtra(SessionService.EXTRA_MODE, SessionService.MODE_DESKTOP)
+                    } else {
+                        Intent(this@DesktopLauncherActivity, DroiDistributionActivity::class.java)
+                            .putExtra("distribution", id)
+                    }
+                    startActivity(launch)
+                }
+            })
+        }
+        setContentView(menu)
+    }
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/DroiDistributionActivity.kt b/app/src/main/java/com/droiddeck/launcher/DroiDistributionActivity.kt
new file mode 100644
index 0000000..d23beec
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/DroiDistributionActivity.kt
@@ -0,0 +1,183 @@
+package com.droiddeck.launcher
+
+import android.app.Activity
+import android.os.Bundle
+import android.os.SystemClock
+import android.webkit.WebResourceRequest
+import android.webkit.WebResourceResponse
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import android.widget.TextView
+import com.droiddeck.launcher.core.AddonPack
+import com.droiddeck.launcher.runtime.LinuxNetworkLinkComponent
+import com.droiddeck.launcher.runtime.LinuxRuntime
+import com.droiddeck.launcher.runtime.LinuxRuntimeInstaller
+import java.io.ByteArrayInputStream
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.InetAddress
+import java.net.ServerSocket
+import java.net.URL
+import java.nio.file.Files
+import java.security.SecureRandom
+
+class DroiDistributionActivity : Activity() {
+    @Volatile private var closed = false
+    @Volatile private var guest: Process? = null
+    private var viewer: WebView? = null
+    private lateinit var status: TextView
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val id = intent.getStringExtra("distribution")
+        if (id !in listOf("debian", "fedora") || id == null) {
+            finish()
+            return
+        }
+        status = TextView(this).apply {
+            text = "Préparation de Linux…"
+            gravity = android.view.Gravity.CENTER
+        }
+        setContentView(status)
+        Thread({
+            try {
+                check(AddonPack.PROOT.await(this, { !closed })) {
+                    AddonPack.PROOT.failure ?: "PRoot indisponible"
+                }
+                val root = prepareDistribution(id)
+                if (!closed) launchDesktop(id, root)
+            } catch (error: Exception) {
+                updateStatus("Impossible de démarrer $id\n${error.message.orEmpty()}")
+            } finally {
+                guest?.destroy()
+            }
+        }, "droi-$id").start()
+    }
+
+    private fun prepareDistribution(id: String): File = synchronized(installLock) {
+        check(!closed)
+        val parent = File(filesDir, "distributions").apply { mkdirs() }
+        val root = File(parent, id)
+        if (File(root, ".installed").isFile) return@synchronized root
+        val staging = File(parent, "$id.partial")
+        val archive = File(parent, "$id.tar.zst")
+        remove(staging)
+        updateStatus("Installation de $id…")
+        try {
+            assets.open("droi/$id.tar.zst").use { input ->
+                archive.outputStream().use { output -> input.copyTo(output) }
+            }
+            check(!closed)
+            check(staging.mkdir())
+            check(LinuxRuntimeInstaller.extract(this, archive, staging, null)) { "Archive Linux illisible" }
+            check(File(staging, "usr/local/bin/droi-desktop").canExecute()) { "Archive Linux incomplète" }
+            File(staging, ".installed").writeText(id)
+            check(root.exists().not() && staging.renameTo(root)) { "Installation impossible" }
+        } finally {
+            archive.delete()
+            remove(staging)
+        }
+        root
+    }
+
+    private fun launchDesktop(id: String, root: File) {
+        val resolver = File(root, "etc/resolv.conf")
+        Files.deleteIfExists(resolver.toPath())
+        LinuxNetworkLinkComponent(this, root).publish()
+        val display = 100 + SecureRandom().nextInt(800)
+        val ports = ServerSocket(0, 1, loopback).use { web ->
+            ServerSocket(0, 1, loopback).use { vnc -> web.localPort to vnc.localPort }
+        }
+        val (webPort, vncPort) = ports
+        val password = ByteArray(4).also(SecureRandom()::nextBytes).joinToString("") { "%02x".format(it) }
+        val command = LinuxRuntime.commandWithBinds(
+            this, root, listOf("/dev", "/proc", "/sys"),
+            listOf("/usr/local/bin/droi-desktop", "$webPort", "$vncPort", "$display"), true,
+        )
+        val log = File(filesDir, "distributions/$id.log")
+        val process = ProcessBuilder(command).directory(root).redirectErrorStream(true).redirectOutput(log).apply {
+            environment()["PROOT_LOADER"] = LinuxRuntime.prootLoader(this@DroiDistributionActivity).path
+            environment()["PROOT_TMP_DIR"] = LinuxRuntime.prootTempDir(this@DroiDistributionActivity).path
+            environment()["PROOT_NO_SECCOMP"] = "1"
+        }.start()
+        guest = process
+        if (closed) return
+        process.outputStream.bufferedWriter().use { it.write("$password\n") }
+        updateStatus("Démarrage du bureau XFCE…")
+        val url = "http://127.0.0.1:$webPort/vnc.html"
+        val deadline = SystemClock.elapsedRealtime() + 300_000
+        while (!closed && process.isAlive && SystemClock.elapsedRealtime() < deadline) {
+            if (responds(url)) {
+                runOnUiThread {
+                    if (!closed) showDesktop(url, webPort, password)
+                }
+                process.waitFor()
+                if (!closed) runOnUiThread { if (!closed) finish() }
+                return
+            }
+            Thread.sleep(250)
+        }
+        if (!closed) {
+            val details = log.readLines().takeLast(3).joinToString("\n")
+            error(details.ifBlank { "Le serveur d’affichage n’a pas démarré." })
+        }
+    }
+
+    private fun responds(url: String): Boolean = runCatching {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        try {
+            connection.connectTimeout = 500
+            connection.readTimeout = 500
+            connection.responseCode == 200
+        } finally {
+            connection.disconnect()
+        }
+    }.getOrDefault(false)
+
+    private fun showDesktop(url: String, port: Int, password: String) {
+        viewer = WebView(this).apply {
+            settings.javaScriptEnabled = true
+            settings.domStorageEnabled = true
+            settings.allowFileAccess = false
+            settings.allowContentAccess = false
+            webViewClient = object : WebViewClient() {
+                private fun allowed(request: WebResourceRequest) =
+                    request.url.scheme == "http" && request.url.host == "127.0.0.1" && request.url.port == port
+
+                override fun shouldOverrideUrlLoading(view: WebView, request: WebResourceRequest) = !allowed(request)
+
+                override fun shouldInterceptRequest(view: WebView, request: WebResourceRequest): WebResourceResponse? =
+                    if (allowed(request)) null else WebResourceResponse("text/plain", "UTF-8", ByteArrayInputStream(byteArrayOf()))
+            }
+        }.also {
+            setContentView(it)
+            it.loadUrl("$url?autoconnect=1&resize=scale#password=$password")
+        }
+    }
+
+    private fun remove(file: File) {
+        if (!Files.exists(file.toPath(), java.nio.file.LinkOption.NOFOLLOW_LINKS)) return
+        Files.walk(file.toPath()).use { paths ->
+            paths.sorted(Comparator.reverseOrder()).forEach { Files.deleteIfExists(it) }
+        }
+    }
+
+    private fun updateStatus(message: String) = runOnUiThread {
+        if (!closed) status.text = message
+    }
+
+    override fun onDestroy() {
+        closed = true
+        guest?.destroy()
+        viewer?.let {
+            (it.parent as? android.view.ViewGroup)?.removeView(it)
+            it.destroy()
+        }
+        super.onDestroy()
+    }
+
+    private companion object {
+        val installLock = Any()
+        val loopback: InetAddress = InetAddress.getByName("127.0.0.1")
+    }
+}
diff --git a/tools/droi/Dockerfile b/tools/droi/Dockerfile
new file mode 100644
index 0000000..9db1ab8
--- /dev/null
+++ b/tools/droi/Dockerfile
@@ -0,0 +1,21 @@
+ARG DISTRO=debian
+FROM debian:13-slim AS debian
+RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
+    ca-certificates dbus-x11 fonts-dejavu-core novnc websockify tigervnc-standalone-server \
+    tigervnc-tools xvfb x11vnc xfce4 xfce4-terminal x11-utils xauth xkb-data && rm -rf /var/lib/apt/lists/*
+RUN ln -s /usr/bin/Xtigervnc /usr/local/bin/droi-xvnc && \
+    ln -s /usr/bin/tigervncpasswd /usr/local/bin/droi-vncpasswd && \
+    mkdir -p /usr/local/share/droi && cp -aL /usr/share/novnc /usr/local/share/droi/novnc
+
+FROM fedora:44 AS fedora
+RUN dnf -y --setopt=install_weak_deps=False install ca-certificates dbus-x11 dejavu-sans-fonts \
+    python3-websockify /usr/bin/Xvnc /usr/bin/vncpasswd xorg-x11-server-Xvfb x11vnc xfce4-session xfce4-panel xfwm4 xfdesktop \
+    xfce4-settings thunar xfce4-terminal xorg-x11-xauth /usr/bin/xdpyinfo xkeyboard-config && dnf clean all
+COPY --from=debian /usr/local/share/droi/novnc /usr/local/share/droi/novnc
+RUN ln -s /usr/bin/Xvnc /usr/local/bin/droi-xvnc && \
+    ln -s /usr/bin/vncpasswd /usr/local/bin/droi-vncpasswd
+
+FROM ${DISTRO}
+COPY desktop.sh /usr/local/bin/droi-desktop
+RUN test -x /usr/local/bin/droi-xvnc && test -x /usr/local/bin/droi-vncpasswd && \
+    test -f /usr/local/share/droi/novnc/vnc.html && python3 -m websockify --help >/dev/null
diff --git a/tools/droi/desktop.sh b/tools/droi/desktop.sh
new file mode 100755
index 0000000..1111111
--- /dev/null
+++ b/tools/droi/desktop.sh
@@ -0,0 +1,168 @@
+#!/bin/bash
+set -euo pipefail
+
+web_port=$1
+vnc_port=$2
+display_number=$3
+read -r password
+
+export HOME=/root USER=root LOGNAME=root LANG=C.UTF-8
+export DISPLAY=:$display_number XDG_RUNTIME_DIR=/tmp/droi-runtime-$display_number
+export NO_AT_BRIDGE=1 LIBGL_ALWAYS_SOFTWARE=1
+unset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS
+
+mkdir -p "$HOME" /tmp/.X11-unix "$XDG_RUNTIME_DIR"
+chmod 1777 /tmp/.X11-unix
+chmod 700 "$XDG_RUNTIME_DIR"
+export XAUTHORITY="$XDG_RUNTIME_DIR/Xauthority"
+xauth -f "$XAUTHORITY" add "$DISPLAY" MIT-MAGIC-COOKIE-1 "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
+printf '%s\n' "$password" | droi-vncpasswd -f > "$XDG_RUNTIME_DIR/passwd"
+chmod 600 "$XDG_RUNTIME_DIR/passwd"
+unset password
+
+# PRoot cannot reliably unwind a thread if libgcc_s is loaded lazily.
+gcc_preload=
+for lib in /lib/aarch64-linux-gnu/libgcc_s.so.1 /usr/lib/aarch64-linux-gnu/libgcc_s.so.1 /lib64/libgcc_s.so.1 /usr/lib64/libgcc_s.so.1; do
+    if [ -r "$lib" ]; then gcc_preload="$lib"; break; fi
+done
+run_x() {
+    if [ -n "$gcc_preload" ]; then
+        exec env LD_PRELOAD="$gcc_preload${LD_PRELOAD:+:$LD_PRELOAD}" "$@"
+    else
+        exec "$@"
+    fi
+}
+x_pid=
+vnc_pid=
+web_pid=
+desktop_pid=
+cleanup() {
+    for pid in "$desktop_pid" "$web_pid" "$vnc_pid" "$x_pid"; do
+        if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; fi
+    done
+    rm -rf -- "$XDG_RUNTIME_DIR"
+}
+trap cleanup EXIT
+trap 'exit 0' TERM INT
+wait_x() {
+    for _ in {1..80}; do
+        if ! kill -0 "$x_pid" 2>/dev/null; then return 1; fi
+        if xdpyinfo >/dev/null 2>&1; then return 0; fi
+        sleep .25
+    done
+    return 1
+}
+start_fallback() {
+    echo "Droi: switching to Xvfb + x11vnc"
+    if ! command -v Xvfb >/dev/null || ! command -v x11vnc >/dev/null; then
+        echo "Droi: installing missing display packages in existing distribution"
+        if command -v apt-get >/dev/null; then
+            timeout 200 bash -c 'apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xvfb x11vnc'
+        elif command -v dnf >/dev/null; then
+            timeout 200 dnf -y --setopt=install_weak_deps=False install xorg-x11-server-Xvfb x11vnc
+        else
+            echo "Droi: no supported package manager" >&2
+            return 1
+        fi
+    fi
+    run_x Xvfb "$DISPLAY" -screen 0 1280x720x24 -nolock -nolisten tcp \
+        -extension MIT-SHM -extension GLX -auth "$XAUTHORITY" &
+    x_pid=$!
+    wait_x || { echo "Droi: Xvfb failed" >&2; return 1; }
+    run_x x11vnc -display "$DISPLAY" -auth "$XAUTHORITY" -localhost \
+        -rfbport "$vnc_port" -rfbauth "$XDG_RUNTIME_DIR/passwd" -forever -shared -noshm -noxdamage &
+    vnc_pid=$!
+    # Verify an RFB listener before opening the browser viewer.
+    for _ in {1..40}; do
+        kill -0 "$vnc_pid" 2>/dev/null || return 1
+        if (echo >/dev/tcp/127.0.0.1/"$vnc_port") 2>/dev/null; then return 0; fi
+        sleep .25
+    done
+    return 1
+}
+if [ "${DROI_FORCE_XVFB:-0}" != 1 ]; then
+    echo "Droi: starting TigerVNC with PRoot compatibility settings"
+    run_x droi-xvnc "$DISPLAY" -localhost -interface 127.0.0.1 -UseIPv6=0 -nolock -nolisten tcp \
+        -extension MIT-SHM -extension GLX -rfbport "$vnc_port" \
+        -SecurityTypes VncAuth -PasswordFile "$XDG_RUNTIME_DIR/passwd" \
+        -auth "$XAUTHORITY" -geometry 1280x720 -depth 24 &
+    x_pid=$!
+fi
+if [ -z "$x_pid" ] || ! wait_x; then
+    if [ -n "$x_pid" ]; then
+        kill "$x_pid" 2>/dev/null || true
+        wait "$x_pid" 2>/dev/null || true
+        x_pid=
+        rm -f -- "/tmp/.X11-unix/X$display_number" "/tmp/.X${display_number}-lock"
+    fi
+    start_fallback || { echo "Droi: fallback display server failed" >&2; exit 1; }
+fi
+dbus-run-session -- xfce4-session &
+desktop_pid=$!
+# The APK carries an independent copy of the complete noVNC web client.
+web_root=/usr/local/share/droi/novnc
+if [ -f "$XDG_RUNTIME_DIR/novnc.tar.gz" ]; then
+    echo "Droi: preparing bundled noVNC assets"
+    mkdir -p "$XDG_RUNTIME_DIR/novnc"
+    python3 -m tarfile -e "$XDG_RUNTIME_DIR/novnc.tar.gz" "$XDG_RUNTIME_DIR/novnc"
+    web_root="$XDG_RUNTIME_DIR/novnc"
+elif [ ! -f "$web_root/vnc.html" ] && [ -f /usr/share/novnc/vnc.html ]; then
+    web_root=/usr/share/novnc
+fi
+for asset in vnc.html app/ui.js core/rfb.js; do
+    if [ ! -r "$web_root/$asset" ]; then
+        echo "Droi: missing noVNC asset $web_root/$asset" >&2
+        exit 1
+    fi
+done
+echo "Droi: starting noVNC viewer"
+# websockify normally relies on chdir/getcwd. Under PRoot these may expose
+# host paths; force an explicit guest web root for every static HTTP request.
+python3 -u - "$web_root" "$web_port" "$vnc_port" <<'PY' &
+import http.server
+import multiprocessing
+import sys
+# Python 3.14 defaults to forkserver, which cannot import /<stdin>.
+# Linux Websockify workers must inherit the patched HTTP handler.
+multiprocessing.set_start_method("fork", force=True)
+from websockify.websocketproxy import websockify_init
+
+root, web_port, vnc_port = sys.argv[1:]
+original = http.server.SimpleHTTPRequestHandler.translate_path
+def translate_path(self, path):
+    self.directory = root
+    return original(self, path)
+http.server.SimpleHTTPRequestHandler.translate_path = translate_path
+sys.argv = ["websockify", "--web", root, "127.0.0.1:" + web_port,
+            "127.0.0.1:" + vnc_port]
+websockify_init()
+PY
+web_pid=$!
+# Fail quickly with the precise HTTP error instead of polling for five minutes.
+python3 -u - "$web_port" <<'PY'
+import sys
+import time
+import urllib.request
+import urllib.error
+
+base = "http://127.0.0.1:" + sys.argv[1]
+for attempt in range(20):
+    try:
+        for path in ("/vnc.html", "/app/ui.js", "/core/rfb.js"):
+            with urllib.request.urlopen(base + path, timeout=1) as response:
+                if not response.read(32):
+                    raise RuntimeError("empty noVNC resource " + path)
+        print("Droi: noVNC assets verified", flush=True)
+        break
+    except urllib.error.HTTPError as error:
+        sys.exit("Droi: noVNC HTTP " + str(error.code) + " at " + error.url)
+    except OSError as error:
+        if attempt == 19:
+            sys.exit("Droi: noVNC server unavailable: " + str(error))
+        time.sleep(0.5)
+PY
+if [ -n "$vnc_pid" ]; then
+    wait -n "$x_pid" "$vnc_pid" "$desktop_pid" "$web_pid"
+else
+    wait -n "$x_pid" "$desktop_pid" "$web_pid"
+fi
